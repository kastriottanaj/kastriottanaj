---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { SITE } from "../../lib/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = `Insights on SEO, marketing & automation | ${SITE.name}`;
const description =
  "Notes on SEO, digital marketing and AI automation — what actually moves the needle, and what only looks like it does.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Insights",
    url: `${SITE.url}/blog/`,
    description,
    author: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Insights", item: `${SITE.url}/blog/` },
    ],
  },
];

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base title={title} description={description} schema={schema}>
  <div class="wrap">
    <header class="page-head">
      <span class="kicker">Insights</span>
      <h1 class="page-head__title">Notes on search, marketing and automation</h1>
      <p class="page-head__lede">{description}</p>
    </header>

    <section class="section section--ruled">
      <h2 class="sr-only">All posts</h2>
      <div class="posts">
        {
          posts.map((post) => (
            <article class="post">
              <p class="post__date">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFormat.format(post.data.pubDate)}
                </time>
              </p>
              <h3 class="post__title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="post__desc">{post.data.description}</p>
              <a class="arrow-link arrow-link--sm" href={`/blog/${post.id}/`}>Read the post →</a>
            </article>
          ))
        }
      </div>
    </section>

    <NewsletterForm
      source="blog-index"
      compact
      heading="Get the next one before it's public"
      lede="Subscribers get the short version by email first — practical notes on SEO, marketing and automation, and nothing else."
    />
  </div>

  <CtaBanner />
</Base>
