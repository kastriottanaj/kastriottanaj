---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// The newest post carries the page: it fills the featured card, and both
// "Read the latest post" buttons point at it. Everything after it is a note.
const [featured, ...notes] = posts;

const title = `SEO, Digital Marketing & AI Automation Blog — ${SITE.name}`;
const description =
  "Discover field-tested SEO, digital marketing and AI automation advice to grow search visibility and reduce manual work. Read the latest insights.";

/* The line under the H1. Written for someone already on the page, so it says
   less than the meta description, which has to sell the click. */
const lede =
  "Field-tested ideas for business owners and marketers who want more search visibility and less manual work.";

const heroImage = "/assets/blog/kastriot-tanaj-blog.webp";

/** What the blog covers. Labels only — there is no topic archive to link to. */
const topics = [
  { icon: "i-search", label: "SEO" },
  { icon: "i-megaphone", label: "Digital marketing" },
  { icon: "i-bot", label: "AI automation" },
  { icon: "i-users", label: "From real client work" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Blog",
    url: `${SITE.url}/blog/`,
    description,
    author: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog/` },
    ],
  },
];

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Tags run general → specific, so the last one is the badge worth showing.
const featuredTag = featured?.data.tags.at(-1);
---

<Base
  title={title}
  description={description}
  image={heroImage}
  imageAlt="A laptop showing a search dashboard beside a notebook of automation flowcharts"
  schema={schema}
>
  <div class="blog-page">
    <div class="blog-wrap">
      <section class="blog-hero" aria-labelledby="blog-title">
        <div class="blog-hero__copy">
          <p class="blog-eyebrow">Field notes</p>
          <h1 class="blog-hero__title" id="blog-title">
            Practical SEO, Marketing &amp; Automation Advice That Moves the Needle
          </h1>
          <p class="blog-hero__lede">{lede}</p>
          <div class="blog-hero__actions">
            <a class="blog-button" href={`/blog/${featured.id}/`}>Read the latest post</a>
            <a class="blog-hero__link" href="#latest-notes">Browse all topics →</a>
          </div>
        </div>

        <figure class="blog-hero__visual">
          <img
            src={heroImage}
            width="506"
            height="337"
            alt="A laptop showing a search dashboard beside a notebook of automation flowcharts"
          />
        </figure>
      </section>

      <section class="blog-topics" aria-label="What this blog covers">
        {
          topics.map((topic) => (
            <div class="blog-topic">
              <svg class="blog-topic__icon" aria-hidden="true">
                <use href={`#${topic.icon}`} />
              </svg>
              <span>{topic.label}</span>
            </div>
          ))
        }
      </section>

      <section class="blog-featured" aria-labelledby="featured-heading">
        <p class="blog-eyebrow" id="featured-heading">Featured</p>

        <article class:list={["blog-feature", !featured.data.image && "blog-feature--flat"]}>
          {
            featured.data.image && (
              <div class="blog-feature__media">
                <img
                  src={featured.data.image}
                  width="541"
                  height="209"
                  alt={featured.data.imageAlt ?? ""}
                />
              </div>
            )
          }
          <div class="blog-feature__body">
            <div class="blog-feature__meta">
              <time class="blog-date" datetime={featured.data.pubDate.toISOString()}>
                {dateFormat.format(featured.data.pubDate)}
              </time>
              {featuredTag && <span class="blog-pill">{featuredTag}</span>}
            </div>
            <h2 class="blog-feature__title">
              <a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
            </h2>
            <p class="blog-feature__desc">{featured.data.description}</p>
            <a class="blog-readlink" href={`/blog/${featured.id}/`}>
              Read the post <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      </section>

      <section class="blog-latest" id="latest-notes" aria-labelledby="latest-heading">
        <h2 class="blog-latest__title" id="latest-heading">Latest notes</h2>

        <div class="blog-cards">
          {
            notes.map((post) => (
              <article class:list={["blog-card", !post.data.image && "blog-card--flat"]}>
                {post.data.image && (
                  <div class="blog-card__media">
                    <img
                      src={post.data.image}
                      width="234"
                      height="172"
                      alt={post.data.imageAlt ?? ""}
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="blog-card__body">
                  <time class="blog-date" datetime={post.data.pubDate.toISOString()}>
                    {dateFormat.format(post.data.pubDate)}
                  </time>
                  <h3 class="blog-card__title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p class="blog-card__desc">{post.data.description}</p>
                  <a class="blog-readlink" href={`/blog/${post.id}/`}>
                    Read the post <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>

    <a class="blog-sticky-cta" href={`/blog/${featured.id}/`}>Read the latest post</a>
  </div>

  <CtaBanner />
</Base>

<style is:global>
  /* ── /blog/ ───────────────────────────────────────────────────────────────
     Built to the supplied mockup. Every measurement below was read off that
     render at its 1:1 scale, so the numbers are literal rather than rounded to
     the system's spacing scale — same approach the /work/ index takes. */
  body:has(.blog-page) {
    --blog-red: #e82e0f;
    --blog-ink: #202020;
    --blog-muted: #5f5f5f;
    --blog-meta: #6f6e6e;
    --blog-rule: #cecdcc;
  }

  .blog-page { color: var(--blog-ink); }
  .blog-wrap {
    width: min(100%, 1112px);
    margin-inline: auto;
    padding-inline: 32px;
  }

  .blog-eyebrow {
    margin: 0;
    color: var(--blog-red);
    font-family: var(--font-heading);
    font-size: 10.5px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  /* The mockup hangs the nav and the topic strip wider than the text column:
     copy, cards and headings all start 26px further in on the left while their
     right edges stay on the wrap. Literal, measured off the render. */
  .blog-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 506px);
    column-gap: 51px;
    align-items: start;
    padding-block: 24px 20px;
    padding-left: 26px;
  }

  .blog-hero__copy { padding-top: 20px; }
  .blog-hero__copy .blog-eyebrow { margin-bottom: 18px; }

  .blog-hero__title {
    /* The max-width, not a <br>, is what holds the mockup's three lines — so
       the headline still re-breaks sensibly once the column narrows. */
    max-width: 466px;
    margin: 0;
    font-size: 37px;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .blog-hero__lede {
    /* Holds the mockup's break after "who want" — measured, not guessed. */
    max-width: 420px;
    margin: 16px 0 0;
    color: var(--blog-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .blog-hero__actions {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 20px;
  }

  .blog-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 20px;
    border: 1px solid var(--blog-red);
    background: var(--blog-red);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }
  .blog-button:hover {
    background: #cf260b;
    border-color: #cf260b;
    color: #fff;
  }

  .blog-hero__link {
    color: var(--blog-red);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 800;
    text-decoration: none;
  }
  .blog-hero__link:hover { text-decoration: underline; }

  .blog-hero__visual {
    width: 506px;
    max-width: 100%;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .blog-hero__visual img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── Topic strip ──────────────────────────────────────────────────────── */
  .blog-topics {
    display: grid;
    /* The mockup's dividers land at 263 / 540 / 792 of the 1048px strip —
       content-weighted cells, not quarters. */
    grid-template-columns: 225fr 277fr 252fr 294fr;
    border-block: 1px solid var(--blog-rule);
  }

  .blog-topic {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 12px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.25;
  }
  .blog-topic + .blog-topic { border-left: 1px solid var(--blog-rule); }

  .blog-topic__icon {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Featured ─────────────────────────────────────────────────────────── */
  .blog-featured { padding: 20px 0 0 26px; }
  .blog-featured .blog-eyebrow { margin-bottom: 4px; }

  .blog-feature {
    display: grid;
    grid-template-columns: 53% minmax(0, 1fr);
    border: 1px solid var(--blog-rule);
  }
  .blog-feature--flat { grid-template-columns: minmax(0, 1fr); }

  /* Taken out of flow so the card is exactly as tall as its text — left to
     size itself, a 1672px-wide photo would set the row height instead. */
  .blog-feature__media { position: relative; }
  .blog-feature__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-feature__body { padding: 18px 24px 20px 40px; }

  .blog-feature__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .blog-date {
    display: block;
    color: var(--blog-meta);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .blog-pill {
    flex: none;
    padding: 6px 13px;
    border: 1px solid var(--blog-rule);
    border-radius: 999px;
    color: var(--blog-ink);
    font-family: var(--font-heading);
    font-size: 8.5px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .blog-feature__title {
    margin: 15px 0 0;
    font-size: 22.5px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .blog-feature__desc {
    max-width: 42ch;
    margin: 8px 0 0;
    color: var(--blog-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .blog-feature .blog-readlink { margin-top: 17px; }

  .blog-feature__title a,
  .blog-card__title a { color: inherit; text-decoration: none; }
  .blog-feature__title a:hover,
  .blog-card__title a:hover { color: var(--blog-red); }

  .blog-readlink {
    display: inline-block;
    margin-top: 16px;
    color: var(--blog-red);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }
  .blog-readlink:hover { text-decoration: underline; }

  /* ── Latest notes ─────────────────────────────────────────────────────── */
  .blog-latest { padding: 14px 0 18px 26px; }

  .blog-latest__title {
    margin: 0 0 6px;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .blog-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 21px;
  }

  .blog-card {
    display: grid;
    grid-template-columns: 48% minmax(0, 1fr);
    border: 1px solid var(--blog-rule);
  }
  .blog-card--flat { grid-template-columns: minmax(0, 1fr); }

  .blog-card__media { position: relative; }
  .blog-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-card__body { padding: 16px 22px 18px 30px; }

  .blog-card__title {
    margin: 9px 0 0;
    font-size: 15.5px;
    line-height: 1.16;
    letter-spacing: -0.015em;
  }

  /* A note card runs tighter than the featured card — smaller body copy and
     less air between the lines, exactly as the mockup draws the pair. */
  .blog-card .blog-readlink { margin-top: 19px; }

  .blog-card__desc {
    margin: 8px 0 0;
    color: var(--blog-muted);
    font-size: 11.5px;
    line-height: 1.5;
  }

  /* Shown only once the layout stacks — see the 720px block. */
  .blog-sticky-cta { display: none; }

  @media (max-width: 1050px) and (min-width: 721px) {
    .blog-hero {
      grid-template-columns: minmax(280px, 1fr) minmax(0, 1fr);
      column-gap: 40px;
    }
    .blog-hero__visual { width: 100%; }
    .blog-hero__title { max-width: none; font-size: 32px; }
    .blog-hero__lede { max-width: 46ch; }
    .blog-topic { padding-inline: 8px; gap: 8px; font-size: 12px; }
    .blog-feature__body { padding-inline: 26px; }
    .blog-feature__title { font-size: 21px; }
    .blog-card__body { padding: 14px 16px 16px 20px; }
    .blog-card__title { font-size: 16px; }
  }

  @media (max-width: 720px) {
    /* Clears the fixed bar at the foot of the page. */
    body:has(.blog-page) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    body:has(.blog-page) .whatsapp-fab { display: none; }

    .blog-wrap { padding-inline: 20px; }

    .blog-hero {
      display: block;
      padding: 22px 0 0;
    }
    .blog-hero__copy { padding-top: 0; }
    .blog-hero__copy .blog-eyebrow { margin-bottom: 14px; }
    .blog-eyebrow { font-size: 12px; }
    .blog-hero__title {
      max-width: none;
      font-size: 31px;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }
    .blog-hero__lede { max-width: none; margin-top: 18px; font-size: 15px; line-height: 1.6; }
    .blog-hero__actions { margin-top: 20px; margin-bottom: 22px; }
    /* The strip below doubles as the topic browser once the page is one column. */
    .blog-hero__link { display: none; }
    .blog-button { min-height: 46px; font-size: 14px; }
    /* The hero picture is the one element the mockup drops on a phone. */
    .blog-hero__visual { display: none; }

    .blog-topic {
      flex-direction: column;
      gap: 8px;
      padding: 14px 6px;
      text-align: center;
      font-size: 11.5px;
    }

    .blog-featured { padding: 22px 0 0; }
    .blog-feature { grid-template-columns: minmax(0, 1fr); }
    /* The picture keeps its letterbox crop once it moves above the text. */
    .blog-feature__media { aspect-ratio: 2.6 / 1; }
    .blog-feature__body { padding: 16px 18px 18px; }
    .blog-feature__title { margin-top: 10px; font-size: 19px; }
    .blog-feature__desc { max-width: none; margin-top: 10px; }
    .blog-readlink { margin-top: 14px; }

    .blog-latest { padding: 22px 0 18px; }
    .blog-date { font-size: 11px; }
    .blog-pill { font-size: 9.5px; }
    .blog-readlink { font-size: 13px; }
    .blog-latest__title { margin-bottom: 12px; }

    /* One bordered list rather than a stack of boxes, so the rows read as a
       single run down the page — the way the mockup's phone frame draws it. */
    .blog-cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      border: 1px solid var(--blog-rule);
    }
    .blog-card {
      grid-template-columns: 116px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
      padding: 16px;
      border: 0;
    }
    .blog-card + .blog-card { border-top: 1px solid var(--blog-rule); }
    .blog-card__media { height: 116px; align-self: start; }
    .blog-card__body { padding: 0; }
    .blog-card__title { margin-top: 8px; font-size: 17px; }
    .blog-card__desc { margin-top: 8px; font-size: 13px; }

    .blog-sticky-cta {
      position: fixed;
      z-index: 950;
      right: 0;
      bottom: 0;
      left: 0;
      min-height: calc(64px + env(safe-area-inset-bottom));
      display: flex;
      align-items: center;
      justify-content: center;
      padding-bottom: env(safe-area-inset-bottom);
      border-top: 1px solid #b91f08;
      background: var(--blog-red);
      color: #fff;
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 800;
      line-height: 1;
      text-decoration: none;
    }
    body:has(.cookie-consent:not([hidden])) .blog-sticky-cta { display: none; }
  }
</style>
