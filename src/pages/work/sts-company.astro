---
/**
 * STS Bau — hand-built case study.
 *
 * Every other entry in the `work` collection renders through [slug].astro, and
 * that route deliberately skips this one (see the filter there). Built by hand
 * for the same reason as gerti-foods.astro: the metric ribbon, the plotted
 * traffic chart and the screenshot gallery are structure rather than prose.
 *
 * The slug stays sts-company because that is the indexed URL. Only the client
 * name changed to STS Bau.
 *
 * Every figure below is read off a screenshot in /assets/sts-evidence/ — four
 * sources over four windows, which the captions state: Semrush and Ubersuggest
 * (28 Aug 2026), GTmetrix (27 Aug 2026) and Google Business Profile (Mar – Aug
 * 2026).
 *
 * The headline is Semrush's: 178 monthly visits, 343 keywords. Ubersuggest puts
 * the same domain at 57 and 217 — the two model organic traffic differently —
 * so its screenshots stay in the gallery as a second opinion, always labelled.
 * Never present one tool's figure as the other's.
 *
 * The one exception is `topTen`, which has no export behind it: it is a live
 * Ubersuggest pull of 28 Aug 2026, and the page says so above the list.
 * Do not round, restate or refresh a number without changing its source.
 */
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";
import { EVIDENCE as evidence } from "../../lib/sts-evidence";

const entry = await getEntry("work", "sts-company");
if (!entry) throw new Error("src/content/work/sts-company.md is missing.");

const { title, client, description, video } = entry.data;
const url = `${SITE.url}/work/sts-company/`;
const absolute = (path: string) => new URL(path, SITE.url).href;

/** 123 -> "PT2M3S". Same helper as [slug].astro. */
function isoDuration(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return `PT${minutes ? `${minutes}M` : ""}${rest}S`;
}

/* ── The numbers, each tied to the screenshot it came from ──────────────── */

/* The two search cells are Semrush, the two local cells Google Business
   Profile — the ribbon names both above it, and every figure is checkable
   against a screenshot in the gallery. The diagnostics that used to sit here
   (backlinks, on-page score) moved down to the chart stats and the strip. */
const metrics = [
  { value: "178", delta: "↑105%", spoken: "up 105 percent", label: "Monthly organic visits" },
  { value: "343", delta: "↑1.2%", spoken: "up 1.2 percent", label: "Ranking keywords" },
  { value: "992", delta: null, spoken: null, label: "Business Profile views" },
  { value: "272", delta: null, spoken: null, label: "Direction requests" },
];

const values = [
  {
    title: "Answer the rule, win the job",
    body: "Nobody wakes up wanting a lightning rod — they read a building regulation, an insurance clause or an inspection notice. The pages were built around those questions, so \"blitzableiter pflicht\" now lands STS on page one.",
    paths: ['<rect x="3" y="5" width="26" height="22" rx="2"/><path d="M3 11h26M8 17h8M8 21h13"/>'],
  },
  {
    title: "A reference library, not a brochure",
    body: "DIN 18014, earthing, equipotential bonding, surge protection, inspection intervals — each explained on a page of its own. 343 keywords rank today, against a handful two years ago.",
    paths: ['<circle cx="14" cy="14" r="9"/><path d="M21 21l7 7M11 14h6M14 11v6"/>'],
  },
  {
    title: "Found on the map, not just the web",
    body: "992 people viewed the Business Profile, 272 asked for directions and 44 clicked through to the site — a whole channel that never touches a search result page, and the one a local trade lives on.",
    paths: ['<circle cx="16" cy="16" r="12"/><path d="M4 16h24M16 4c4 4 4 20 0 24M16 4c-4 4-4 20 0 24"/>'],
  },
];

const steps = [
  {
    n: "01",
    title: "Map the regulation, not the service",
    body: "The German search demand around Blitzschutz is compliance-shaped: is it required, which norm applies, how often must it be inspected. That map decided every page that followed.",
  },
  {
    n: "02",
    title: "Build the Ratgeber",
    body: "A technical knowledge hub answering one question per page — 115 articles across lightning protection, earthing, equipotential bonding and surge protection.",
  },
  {
    n: "03",
    title: "A page for every sector",
    body: "Eighteen service and sector pages, so a hospital's facilities manager and a logistics operator each land on copy written for their building.",
  },
  {
    n: "04",
    title: "On-page cleanup across the domain",
    body: "Titles, headings, internal links and metadata rewritten against that map. On-page score now 89 out of 100.",
  },
];

const chartStats = [
  { figure: "+105%", label: "organic traffic month on month" },
  { figure: "343", label: "keywords ranking in Germany" },
  { figure: "+800%", label: "backlinks (18 in total)" },
  { figure: "89", label: "on-page SEO score" },
];

const speed = [
  { value: "A", label: "GTmetrix grade" },
  { value: "97%", label: "Performance" },
  { value: "1.1s", label: "LCP" },
  { value: "0ms", label: "Total blocking time" },
  { value: "0", label: "Layout shift" },
];

/* The three terms sitting inside Google's top ten, with their German monthly
   search volumes. A live Ubersuggest pull of 28 Aug 2026 — the one block on
   this page with no committed export behind it, and it is labelled as such. */
const topTen = [
  { term: "blitzableiter pflicht", position: 8, volume: "390/mo" },
  { term: "blitzableiter neubau", position: 6, volume: "140/mo" },
  { term: "ist ein blitzableiter pflicht", position: 6, volume: "140/mo" },
];

const cards = [
  {
    kicker: "01 · Foundation",
    title: "Technical & on-page SEO",
    body: "Audit, fixes and a page structure built around the questions your buyers actually type.",
    cta: "See what's included →",
    href: "/services/seo/",
  },
  {
    kicker: "02 · Visibility",
    title: "AI search visibility (GEO)",
    body: "Get named in ChatGPT, Gemini and AI Overviews when someone asks who does this work.",
    cta: "Check your AI visibility →",
    href: "/services/",
  },
  {
    kicker: "03 · Growth",
    title: "Content strategy & production",
    body: "A keyword-to-page map and the content to fill it — in German, English or Albanian.",
    cta: "See the content plan →",
    href: "/services/digital-marketing/",
  },
];

const pageTitle = "STS Bau SEO Case Study: 178 Monthly Organic Visits";

/* CreativeWork rather than Article, to match the shape the other case studies
   already emit through [slug].astro. */
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    description,
    url,
    about: { "@type": "Organization", name: client },
    author: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
    datePublished: "2026",
  },
  ...(video
    ? [
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          name: video.title,
          description: video.description,
          thumbnailUrl: absolute(video.poster),
          contentUrl: absolute(video.src),
          uploadDate: video.date,
          duration: isoDuration(video.duration),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Work", item: `${SITE.url}/work/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<Base
  title={pageTitle}
  description={description}
  image={evidence.traffic.src}
  imageAlt={evidence.traffic.alt}
  schema={schema}
>
  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <section class="cs-hero-band" data-sticky-after>
    <div class="wrap cs-hero">
      <div class="cs-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span>
          <a href="/work/">Work</a> <span aria-hidden="true">/</span>
          <span aria-current="page">STS Bau</span>
        </nav>

        <p class="cs-eyebrow">Case study · SEO for industrial &amp; trade businesses</p>
        <h1 class="cs-hero__title">
          SEO that took STS Bau from a <span class="cs-mark">flat line</span> to 178 monthly organic visits
        </h1>
        <p class="cs-hero__sub">
          Content-led SEO for a German Blitzschutzbau and Steuerungstechnik specialist — 343 keywords
          now ranking in Germany, organic traffic up 105%, and a reference library that earns the
          enquiry before a competitor is ever searched for.
        </p>

        <div class="cs-actions">
          <a class="btn btn-primary" href={SITE.whatsappUrl} target="_blank" rel="noopener">
            Book a strategy call
          </a>
          <a class="btn btn-secondary" href="#evidence">See the proof</a>
        </div>

        <p class="cs-contact">
          <span class="cs-pip" aria-hidden="true"></span>
          WhatsApp <a href={SITE.whatsappUrl} target="_blank" rel="noopener">{SITE.phoneDisplay}</a>
          <span>
            <span class="cs-contact__sep" aria-hidden="true">|</span>
            Working with industrial &amp; trade businesses in Germany, Austria and Switzerland
          </span>
        </p>
      </div>

      {
        video && (
          <figure class="cs-video">
            {/* Two minutes of Kastriot on camera — the page's primary evidence,
                so it plays in place rather than linking out. preload="metadata"
                fetches the header only; the poster carries the first frame. */}
            <video
              class="cs-video__el"
              controls
              playsinline
              preload="metadata"
              poster={video.poster}
              width="464"
              height="832"
            >
              <source src={video.src} type="video/mp4" />
            </video>
            <div class="cs-video__shade" aria-hidden="true" />
            <figcaption class="cs-video__caption">
              <span class="cs-video__line">Me, on camera, on what actually changed.</span>
              <span class="cs-video__meta">{video.title}</span>
            </figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <!-- ── Results ribbon ─────────────────────────────────────────────────── -->
  <section class="cs-ribbon" aria-label="Headline results">
    <div class="wrap">
      <p class="cs-ribbon__top">
        <span>Verified in Semrush and Google Business Profile</span>
        <span><b>sts-steuerungstechnik.de</b> · exported 28 Aug 2026</span>
      </p>
      <ul class="cs-metrics">
        {
          metrics.map((metric) => (
            <li class="cs-metric">
              <p class="cs-metric__value">
                {metric.value}
                {metric.delta && (
                  <>
                    <span class="cs-metric__delta" aria-hidden="true">{metric.delta}</span>
                    <span class="sr-only">, {metric.spoken}</span>
                  </>
                )}
              </p>
              <p class="cs-metric__label">{metric.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── What moved ─────────────────────────────────────────────────────── -->
  <section class="cs-section wrap">
    <p class="cs-eyebrow">What actually moved</p>
    <h2 class="cs-h2">Three changes did most of the work</h2>
    <div class="cs-values">
      {
        values.map((value) => (
          <div class="cs-value">
            <svg
              class="cs-glyph"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              focusable="false"
              set:html={value.paths.join("")}
            />
            <h3 class="cs-value__title">{value.title}</h3>
            <p class="cs-value__body">{value.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── The brief / what I did / the chart ─────────────────────────────── -->
  <section class="cs-section wrap" id="breakdown">
    <div class="cs-body">
      <div>
        <p class="cs-eyebrow">The brief</p>
        <h2 class="cs-h2">A specialist trade nobody could find</h2>
        <p class="cs-lede cs-lede--brief">
          STS runs two businesses off one domain: Steuerungstechnik — industrial electrical assembly,
          cable laying and control systems — and Blitzschutzbau, lightning protection for homes,
          commercial buildings and public infrastructure. Skilled, certified, and drawing about two
          organic visits a month in a country where lightning protection is written into building
          law. The brief was to make the expertise findable in German search.
        </p>

        <p class="cs-eyebrow cs-eyebrow--muted">What I did</p>
        <ol class="cs-steps">
          {
            steps.map((step) => (
              <li class="cs-step">
                <span class="cs-step__num" aria-hidden="true">{step.n}</span>
                <div>
                  <h3 class="cs-step__title">{step.title}</h3>
                  <p class="cs-step__body">{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="cs-chart">
        <p class="cs-chart__cap">Monthly organic traffic · Oct 2024 – Jul 2026</p>
        <p class="cs-chart__big">0 → 178 visits</p>
        {/* Hand-plotted against the Semrush trend in the gallery below, on that
            chart's own axis (0–180). The two endpoints are read off the export;
            the months between are traced from its curve, so treat them as the
            shape of the series rather than as figures in their own right. */}
        <svg
          class="cs-chart__svg"
          viewBox="0 0 520 190"
          role="img"
          aria-label="Organic traffic flat near zero from October 2024 through late 2025, lifting from November 2025, peaking briefly in spring 2026 and climbing steeply to 178 monthly visits by July 2026"
        >
          <defs>
            <linearGradient id="cs-fade-sts" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ec3013" stop-opacity=".22" />
              <stop offset="100%" stop-color="#ec3013" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g stroke="#d7d3d3" stroke-width="1">
            <line x1="34" y1="18" x2="510" y2="18" />
            <line x1="34" y1="65" x2="510" y2="65" />
            <line x1="34" y1="112" x2="510" y2="112" />
            <line x1="34" y1="158" x2="510" y2="158" />
          </g>
          <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="#605d5d">
            <text x="6" y="22">180</text>
            <text x="6" y="69">120</text>
            <text x="12" y="116">60</text>
            <text x="18" y="162">0</text>
            <text x="30" y="180">Oct 24</text>
            <text x="205" y="180">Jul 25</text>
            <text x="330" y="180">Feb 26</text>
            <text x="452" y="180">Jul 26</text>
          </g>
          <path
            d="M40 157.2 L60.5 157.2 L81 156.4 L101.4 156.4 L121.9 156.4 L142.4 156.4 L162.9 155.7 L183.3 155.7 L203.8 155.7 L224.3 155.7 L244.8 156.4 L265.2 155.7 L285.7 154.1 L306.2 145.6 L326.7 138.6 L347.1 135.4 L367.6 133.9 L388.1 91.9 L408.6 117.6 L429 125.3 L449.5 119.1 L470 19.6 L470 158 L40 158 Z"
            fill="url(#cs-fade-sts)"
          />
          <polyline
            points="40,157.2 60.5,157.2 81,156.4 101.4,156.4 121.9,156.4 142.4,156.4 162.9,155.7 183.3,155.7 203.8,155.7 224.3,155.7 244.8,156.4 265.2,155.7 285.7,154.1 306.2,145.6 326.7,138.6 347.1,135.4 367.6,133.9 388.1,91.9 408.6,117.6 429,125.3 449.5,119.1 470,19.6"
            fill="none"
            stroke="#ec3013"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          <circle cx="388.1" cy="91.9" r="4" fill="#fff" stroke="#ec3013" stroke-width="2" />
          <circle cx="470" cy="19.6" r="5" fill="#fff" stroke="#ec3013" stroke-width="2.5" />
        </svg>
        <ul class="cs-chart__stats">
          {
            chartStats.map((stat) => (
              <li>
                <b>{stat.figure}</b> {stat.label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ── The outcome ────────────────────────────────────────────────────── -->
  <section class="cs-section wrap">
    <p class="cs-eyebrow">The outcome</p>
    <h2 class="cs-h2">On page one for the question that starts the job</h2>
    <div class="cs-proof">
      <!-- TODO: replace with approved client quote -->
      <figure class="cs-quoteslot">
        <div>
          <p class="cs-quoteslot__tag">Client quote — to add</p>
          <blockquote class="cs-quoteslot__text">
            Two or three sentences from STS in their own words: what changed for the business,
            not for the rankings.
          </blockquote>
        </div>
        <figcaption class="cs-quoteslot__by">
          <span class="cs-avatar" aria-hidden="true">ST</span>
          <span>
            <span class="cs-quoteslot__name">STS Bau</span>
            <span class="cs-quoteslot__role">Blitzschutzbau &amp; Steuerungstechnik · sts-steuerungstechnik.de</span>
          </span>
        </figcaption>
      </figure>

      <div class="cs-result">
        <p class="cs-result__label">Ranking keywords</p>
        <p class="cs-result__value">343</p>
        <p class="cs-result__label">in the German index</p>
        <p class="cs-result__body">
          Three of them inside the top ten, led by <b>blitzableiter pflicht</b> at position 8 —
          390 searches a month from people who have just found out they need one.
        </p>
      </div>
    </div>
  </section>

  <!-- ── The evidence ───────────────────────────────────────────────────── -->
  <section class="cs-section wrap" id="evidence">
    <p class="cs-eyebrow">The evidence</p>
    <h2 class="cs-h2">Every number here, screenshotted from the source</h2>
    <p class="cs-lede">
      Semrush and Ubersuggest, a GTmetrix run, and six months of Google Business Profile —
      exported 27 and 28 August 2026. The two SEO tools estimate organic traffic differently, so
      both are here rather than only the flattering one. Nothing recreated, nothing rounded up.
    </p>

    <div class="cs-ev-grid">
      <figure class="cs-ev cs-ev--4">
        <img
          src={evidence.semrushKeywords.src}
          alt={evidence.semrushKeywords.alt}
          width={evidence.semrushKeywords.width}
          height={evidence.semrushKeywords.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <b>{evidence.semrushKeywords.strong}</b> — {evidence.semrushKeywords.caption}
        </figcaption>
      </figure>

      <figure class="cs-ev cs-ev--2">
        <img
          src={evidence.semrushOverview.src}
          alt={evidence.semrushOverview.alt}
          width={evidence.semrushOverview.width}
          height={evidence.semrushOverview.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <b>{evidence.semrushOverview.strong}</b> — {evidence.semrushOverview.caption}
        </figcaption>
      </figure>

      <figure class="cs-ev cs-ev--6">
        <img
          src={evidence.semrushTrend.src}
          alt={evidence.semrushTrend.alt}
          width={evidence.semrushTrend.width}
          height={evidence.semrushTrend.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <b>{evidence.semrushTrend.strong}</b> — {evidence.semrushTrend.caption}
        </figcaption>
      </figure>

      <figure class="cs-ev cs-ev--4">
        <img
          src={evidence.gtmetrix.src}
          alt={evidence.gtmetrix.alt}
          width={evidence.gtmetrix.width}
          height={evidence.gtmetrix.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption><b>{evidence.gtmetrix.strong}</b> — {evidence.gtmetrix.caption}</figcaption>
      </figure>

      <div class="cs-ev-stack">
        {
          [evidence.indicators, evidence.onpage].map((shot) => (
            <figure class="cs-ev">
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption><b>{shot.strong}</b> — {shot.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      {/* The search half above, the Business Profile half below — paired so each
          row reads as one window rather than two unrelated exports. */}
      {
        [evidence.traffic, evidence.profileViews, evidence.directions, evidence.websiteClicks].map(
          (shot) => (
            <figure class="cs-ev cs-ev--3">
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption><b>{shot.strong}</b> — {shot.caption}</figcaption>
            </figure>
          ),
        )
      }
    </div>

    <ul class="cs-speed">
      {
        speed.map((cell) => (
          <li>
            <p class="cs-speed__value">{cell.value}</p>
            <p class="cs-speed__label">{cell.label}</p>
          </li>
        ))
      }
    </ul>

    <!-- Not from a committed export, and says so. -->
    <p class="cs-eyebrow cs-eyebrow--muted cs-livecheck__head">
      Inside Google's top ten · live Ubersuggest pull, 28 August 2026
    </p>

    <ul class="cs-topten">
      {
        topTen.map((row) => (
          <li>
            <b>#{row.position}</b> <span class="cs-topten__term">{row.term}</span>
            <span class="cs-topten__vol">{row.volume}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── Work with me ───────────────────────────────────────────────────── -->
  <section class="cs-section wrap">
    <p class="cs-eyebrow">Work with me</p>
    <h2 class="cs-h2">The same three levers, for your brand</h2>
    <div class="cs-cards">
      {
        cards.map((card) => (
          <article class="cs-card">
            <p class="cs-card__kicker">{card.kicker}</p>
            <h3 class="cs-card__title">{card.title}</h3>
            <p class="cs-card__body">{card.body}</p>
            <a class="cs-card__cta" href={card.href}>{card.cta}</a>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBanner
    title="Want results like this?"
    lede="Tell me about your business and I'll tell you where the opportunity is."
    ghostLabel={`WhatsApp ${SITE.phoneDisplay}`}
  />

  <!-- Mobile only. Hidden until the hero scrolls away — see site.js. Without
       JS it never appears and the floating WhatsApp button stays instead. -->
  <div class="cs-sticky" data-sticky-cta data-visible="false">
    <a class="btn btn-primary cs-sticky__btn" href={SITE.whatsappUrl} target="_blank" rel="noopener">
      Book a call
    </a>
    <a
      class="cs-sticky__wa"
      href={SITE.whatsappUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Chat with ${SITE.name} on WhatsApp`}
