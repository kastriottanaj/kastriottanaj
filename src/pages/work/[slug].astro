---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";

export const getStaticPaths: GetStaticPaths = async () => {
  /* Case studies that own a hand-built page under src/pages/work/ and so must
     not also be generated here — two routes emitting the same URL collide.
     Declared inside: Astro hoists getStaticPaths into its own scope, so it
     cannot see module-level consts. */
  const bespoke = new Set(["gerti-foods"]);

  const cases = await getCollection(
    "work",
    ({ data, id }) => !data.draft && !bespoke.has(id),
  );
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, client, description, services, year, thumbCaption, video } = entry.data;

const url = `${SITE.url}/work/${entry.id}/`;
const absolute = (path: string) => new URL(path, SITE.url).href;

/** 118 -> "PT1M58S". */
function isoDuration(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return `PT${minutes ? `${minutes}M` : ""}${rest}S`;
}

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    description,
    url,
    about: { "@type": "Organization", name: client },
    author: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
    ...(year ? { datePublished: String(year) } : {}),
  },
  ...(video
    ? [
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          name: video.title,
          description: video.description,
          thumbnailUrl: absolute(video.poster),
          contentUrl: absolute(video.src),
          uploadDate: video.date,
          duration: isoDuration(video.duration),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Work", item: `${SITE.url}/work/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={`${title} — case study | ${SITE.name}`} description={description} schema={schema}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/work/">Work</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <header class="page-head">
      <span class="kicker">Case study</span>
      <h1 class="page-head__title">{title}</h1>
      <p class="page-head__lede">{description}</p>
      {
        services.length > 0 && (
          <p class="tags">
            {services.map((service) => (
              <span class="tag">{service}</span>
            ))}
          </p>
        )
      }
    </header>

    {
      video ? (
        <figure class="case-video">
          {/* Two minutes of narration: it waits to be played rather than
              autoplaying, and preload="none" keeps the file off the wire
              until someone asks for it. */}
          <video controls preload="none" playsinline poster={video.poster} width="464" height="832">
            <source src={video.src} type="video/mp4" />
          </video>
          <figcaption>{video.title}</figcaption>
        </figure>
      ) : (
        <figure class="thumb thumb--wide">
          <figcaption>{thumbCaption ?? client}</figcaption>
        </figure>
      )
    }

    <div class="prose prose--narrow">
      <Content />
    </div>
  </div>

  <CtaBanner
    title="Want results like this?"
    lede="Tell me about your business and I'll tell you where the opportunity is."
  />
</Base>
