---
import Base from "../layouts/Base.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { SITE } from "../lib/site";
import "../styles/pricing.css";

const title = `SEO & AI Automation Packages & Pricing — ${SITE.name}`;
const description =
  "Explore SEO and AI automation pricing for audits, ongoing growth, and custom builds tailored to your goals. Get a custom quote today.";

const heroImage = "/assets/pricing/seo-automation-packages.webp";

const strip = [
  { icon: "i-file-text", label: "Custom-scoped proposals" },
  { icon: "i-clock", label: "Proposal in 2 business days" },
  { icon: "i-cog", label: "SEO + automation expertise" },
];

const values = [
  {
    icon: "i-crosshair",
    title: "Clear scope",
    desc: "Know what gets done, when, and why.",
  },
  {
    icon: "i-rocket",
    title: "Work that ships",
    desc: "Strategy and implementation in one engagement.",
  },
  {
    icon: "i-puzzle",
    title: "Flexible fit",
    desc: "One-off, monthly, or fixed-price support.",
  },
];

const plans = [
  {
    title: "SEO Audit & Sprint",
    for: "For clarity and a prioritised 90-day roadmap",
    price: "Custom quote",
    includes: [
      "Full technical and content audit",
      "Prioritised 90-day roadmap",
      "On-page and competitor analysis",
    ],
    cta: "Explore the audit",
    desc: "A focused technical, on-page and content audit with an action plan you can use straight away — with me or without me.",
    featured: false,
  },
  {
    title: "Growth Partner",
    for: "For month-over-month SEO and marketing execution",
    price: "Monthly retainer",
    includes: [
      "Everything in the audit & sprint",
      "Monthly execution and reporting",
      "Ongoing on-page and off-page work",
    ],
    cta: "Build a growth plan",
    desc: "An ongoing SEO and digital marketing partnership — strategy, execution and reporting every month, against one metric we agree on up front.",
    featured: true,
  },
  {
    title: "Automation Build",
    for: "For eliminating repetitive work with practical AI and Python systems",
    price: "Fixed price per build",
    includes: [
      "Custom AI or Python automation",
      "Integrates with your existing tools",
      "Documentation and handover",
    ],
    cta: "Scope an automation",
    desc: "A custom AI or Python automation for reporting, lead handling or content workflows — built around the tools you already use, documented and handed over.",
    featured: false,
  },
];

/** The three case studies with numbers attached, in the order /work/ ranks them. */
const featuredWork = [
  {
    href: "/work/gerti-foods/",
    src: "/assets/work/gerti-card.png",
    width: 319,
    height: 86,
    alt: "Gerti Foods ajvar and bread",
    label: "Gerti Foods — 0 to 1,800 monthly impressions",
  },
  {
    href: "/work/sts-company/",
    src: "/assets/work/sts-card.png",
    width: 343,
    height: 86,
    alt: "An STS Bau installer working on lightning protection",
    label: "STS Bau — 1 to 178 monthly organic visits",
  },
  {
    href: "/use-cases/real-estate/",
    src: "/assets/work/as-real-estate-card.png",
    width: 344,
    height: 113,
    alt: "An office tower in Prishtina marked up as an AS Real Estate listing",
    label: "AS Real Estate — 11 to 46 pages indexed",
  },
];

const factors = [
  {
    icon: "i-code",
    title: "Size of the site",
    desc: "A few dozen pages or a few thousand. Crawl depth, template count and technical debt all scale the work.",
  },
  {
    icon: "i-trending",
    title: "How competitive the market is",
    desc: "Ranking in a quiet local market and ranking against national brands are not the same amount of work.",
  },
  {
    icon: "i-search",
    title: "What's already there",
    desc: "Existing content, a healthy site and clean analytics all shorten the runway — and lower the quote.",
  },
  {
    icon: "i-sliders",
    title: "The pace you want",
    desc: "More output per month costs more per month. It does not cost more per unit of work.",
  },
  {
    icon: "i-users",
    title: "Who implements",
    desc: "If your team ships the fixes, you're paying for strategy. If I ship them, you're paying for both.",
  },
  {
    icon: "i-bot",
    title: "How much can be automated",
    desc: "Work that can be handed to a script once is cheaper over a year than work repeated by hand every month.",
  },
];

const quoteSteps = [
  {
    num: "01",
    icon: "i-phone",
    title: "Book a call",
    desc: "Twenty minutes on your site, your market and what you're actually trying to fix.",
  },
  {
    num: "02",
    icon: "i-search",
    title: "Quick review",
    desc: "I look at the site, the search data and two or three competitors before quoting anything.",
  },
  {
    num: "03",
    icon: "i-map",
    title: "Written proposal",
    desc: "Scope, deliverables, timeline and price in writing — usually within two business days.",
  },
  {
    num: "04",
    icon: "i-sliders",
    title: "Start",
    desc: "You approve, we book the kickoff, and week one is the audit.",
  },
];

const faq = [
  {
    q: "Why are there no numbers on this page?",
    a: "Because a fixed public price is either padded to cover the worst case, or it's a bait number that changes on the first call. A forty-page brochure site in a quiet market and a four-thousand-URL store fighting national competitors are not the same job. Tell me the site and the goal and you get a real number in writing before anything starts.",
  },
  {
    q: "What's the minimum commitment?",
    a: "Three months for the Growth Partner, because that's the shortest honest window to judge SEO work — a shorter term mostly means paying for setup twice. After that it runs month to month. The audit sprint and automation builds are one-off.",
  },
  {
    q: "How does payment work?",
    a: "Retainers are invoiced monthly in advance. Builds and audits split 50% up front and 50% on handover.",
  },
  {
    q: "Is ad spend included?",
    a: "No. Any advertising budget goes straight to the platform rather than through me, and the account stays in your name.",
  },
  {
    q: "What if it isn't working?",
    a: "You'll know before I do — that's what the monthly report is for. If the work isn't moving the metric we agreed on, we change the plan or you stop. There's no cancellation fee.",
  },
  {
    q: "Can I combine packages?",
    a: "Most people do. An audit sprint that turns into a retainer is the common path, and an automation build often runs alongside one.",
  },
  {
    q: "Do you work with businesses outside Kosovo?",
    a: `Yes — most of the work is remote across Europe. I'm based in ${SITE.locality} and calls happen on WhatsApp or Google Meet.`,
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Pricing", item: `${SITE.url}/pricing/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    name: "Packages",
    url: `${SITE.url}/pricing/`,
    itemListElement: plans.map((plan, i) => ({
      "@type": "Offer",
      position: i + 1,
      name: plan.title,
      description: plan.desc,
      url: `${SITE.url}/pricing/`,
      priceSpecification: {
        "@type": "PriceSpecification",
        // No public rate card: every engagement is scoped and quoted per site.
        priceCurrency: "EUR",
      },
      itemOffered: {
        "@type": "Service",
        name: plan.title,
        description: plan.desc,
        areaServed: "Europe",
        provider: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title={title}
  description={description}
  image={heroImage}
  imageAlt="An SEO performance dashboard open on a laptop beside a notebook"
  schema={schema}
>
  <div class="pricing-page">
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="pricing-hero" aria-labelledby="pricing-title">
      <div class="pricing-wrap pricing-hero__grid">
        <div class="pricing-hero__copy">
          <p class="pricing-eyebrow">Pricing</p>
          <h1 class="pricing-hero__title" id="pricing-title">
            SEO and Automation Packages Built for Measurable Growth
          </h1>
          <p class="pricing-hero__lede">
            Choose a focused SEO audit, ongoing growth partnership, or custom automation
            build—each scoped to your site, market, and goals.
          </p>
          <div class="pricing-hero__actions">
            <a class="pricing-button pricing-button--primary" href="/contact/">Get a custom quote</a>
            <a class="pricing-button pricing-button--outline" href="/process/">See how it works</a>
          </div>
        </div>
      </div>

      <img
        class="pricing-hero__image"
        src={heroImage}
        width="1536"
        height="1024"
        alt="An SEO performance dashboard open on a laptop beside a notebook"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </section>

    <!-- ── Capability strip ─────────────────────────────────────────────── -->
    <section class="pricing-strip" aria-label="How quoting works">
      <ul class="pricing-wrap pricing-strip__list">
        {
          strip.map((item) => (
            <li>
              <svg aria-hidden="true"><use href={`#${item.icon}`} /></svg>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── What every package gives you ─────────────────────────────────── -->
    <section class="pricing-values" aria-label="What every package gives you">
      <ul class="pricing-wrap pricing-values__list">
        {
          values.map((value) => (
            <li class="pricing-value">
              <svg class="pricing-value__icon" aria-hidden="true">
                <use href={`#${value.icon}`} />
              </svg>
              <div>
                <h3>{value.title}</h3>
                <p>{value.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── Packages ─────────────────────────────────────────────────────── -->
    <section class="pricing-plans" id="packages" aria-labelledby="plans-title">
      <div class="pricing-wrap">
        <h2 class="pricing-plans__title" id="plans-title">Choose the right way to work together</h2>

        <div class="pricing-plans__grid">
          {
            plans.map((plan) => (
              <article class={`pricing-plan${plan.featured ? " pricing-plan--featured" : ""}`}>
                {plan.featured && <p class="pricing-plan__badge">Most popular</p>}
                <h3 class="pricing-plan__title">{plan.title}</h3>
                <p class="pricing-plan__for">{plan.for}</p>
                <p class="pricing-plan__price">{plan.price}</p>
                <ul class="pricing-plan__list">
                  {plan.includes.map((item) => <li>{item}</li>)}
                </ul>
                <a
                  class={`pricing-button ${plan.featured ? "pricing-button--primary" : "pricing-button--outline"}`}
                  href="/contact/"
                >{plan.cta}</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Featured work ────────────────────────────────────────────────── -->
    <section class="pricing-work" aria-labelledby="work-title">
      <div class="pricing-wrap pricing-work__grid">
        <div>
          <h2 id="work-title">Featured work</h2>
          <p class="pricing-work__lede">
            SEO, content, analytics, and automation systems built for real businesses.
          </p>
        </div>

        <ul class="pricing-work__shots">
          {
            featuredWork.map((item) => (
              <li>
                <a href={item.href} aria-label={item.label}>
                  <img
                    src={item.src}
                    width={item.width}
                    height={item.height}
                    alt={item.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="pricing-work__actions">
          <a class="pricing-button pricing-button--outline" href="/work/">View the work</a>
        </div>
      </div>
    </section>

    <!-- ── What shapes your quote ───────────────────────────────────────── -->
    <section class="pricing-detail pricing-detail--split pricing-wrap" aria-labelledby="factors-title">
      <div class="pricing-detail__head">
        <div>
          <p class="pricing-eyebrow">What shapes your quote</p>
          <h2 class="pricing-detail__title" id="factors-title">Six things move the number</h2>
          <p class="pricing-detail__lede">
            None of them is how big your company looks from the outside. Every quote is built
            from the site in front of me, the market it competes in, and the pace you want to
            work at.
          </p>
        </div>

        <figure class="pricing-detail__figure">
          <img
            src="/assets/pricing/what-shapes-your-quote.webp"
            width="1536"
            height="1024"
            alt="A gym owner reviewing her site's search performance on a laptop"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <ul class="pricing-tiles">
        {
          factors.map((factor) => (
            <li class="pricing-tile">
              <svg aria-hidden="true"><use href={`#${factor.icon}`} /></svg>
              <h3>{factor.title}</h3>
              <p>{factor.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── How the quote works ──────────────────────────────────────────── -->
    <section class="pricing-detail pricing-wrap" aria-labelledby="quote-title">
      <div class="pricing-detail__head">
        <p class="pricing-eyebrow">How the quote works</p>
        <h2 class="pricing-detail__title" id="quote-title">From first call to a number in writing</h2>
        <p class="pricing-detail__lede">
          Four steps, and nothing starts until you've approved the scope and the price.
        </p>
      </div>

      <ol class="pricing-tiles pricing-tiles--steps">
        {
          quoteSteps.map((step) => (
            <li class="pricing-tile">
              <svg aria-hidden="true"><use href={`#${step.icon}`} /></svg>
              <p class="pricing-tile__num">{step.num}</p>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </li>
          ))
        }
      </ol>

      <div class="pricing-band">
        <div class="pricing-band__body">
          <p class="pricing-eyebrow">In writing</p>
          <h3>Scope, timeline and price before anything starts</h3>
          <p>
            Every engagement is quoted against your site, your market and the one goal you
            pick. It comes back in writing, usually within two business days — and the number
            in the proposal is the number you pay.
          </p>
          <a class="pricing-link" href="/contact/">Get a custom quote →</a>
        </div>

        <img
          src="/assets/pricing/custom-seo-proposal.webp"
          width="1536"
          height="1024"
          alt="A business owner reading through a written SEO proposal at a desk"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- ── Training ─────────────────────────────────────────────────────── -->
    <section class="pricing-detail pricing-detail--split pricing-wrap" aria-labelledby="training-title">
      <div class="pricing-detail__head">
        <div>
          <p class="pricing-eyebrow">Rather learn it yourself?</p>
          <h2 class="pricing-detail__title" id="training-title">The same work, taught as a course</h2>
          <p class="pricing-detail__lede">
            The bootcamps cover the same SEO and WordPress work as a hands-on course, priced
            separately from the packages above. Good if you'd rather build the skill in-house
            than outsource it.
          </p>
          <p><a class="pricing-link" href="/bootcamps/">See the bootcamps →</a></p>
        </div>

        <figure class="pricing-detail__figure">
          <img
            src="/assets/pricing/seo-training-bootcamps.webp"
            width="1536"
            height="1024"
            alt="A student following an SEO bootcamp lesson on a laptop"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
    <section class="pricing-detail pricing-wrap" aria-labelledby="faq-title">
      <div class="pricing-detail__head">
        <p class="pricing-eyebrow">Common questions</p>
        <h2 class="pricing-detail__title" id="faq-title">Before you ask for a quote</h2>
      </div>

      <div class="pricing-faq">
        {
          faq.map((item) => (
            <details class="pricing-faq__item">
              <summary class="pricing-faq__q">{item.q}</summary>
              <p class="pricing-faq__a">{item.a}</p>
            </details>
          ))
        }
      </div>

      <p class="pricing-next">
        See how the work runs in <a href="/process/">the process</a>, or look at what it moved
        on real projects in the <a href="/work/">case studies</a>.
      </p>
    </section>
  </div>

  <CtaBanner
    icon="i-message"
    title="Not sure which package fits?"
    lede="Tell me the goal and I'll recommend the right starting point."
    ghostLabel={null}
  />

  <a
    class="pricing-contact-bar"
    href={SITE.whatsappUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Contact ${SITE.name} on WhatsApp`}
  >
    <svg aria-hidden="true"><use href="#i-message" /></svg>
    <span>Contact</span>
  </a>
</Base>
