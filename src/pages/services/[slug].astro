---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";

export const getStaticPaths: GetStaticPaths = async () => {
  /* Services that own a hand-built page under src/pages/services/ and so must
     not also be generated here — two routes emitting the same URL collide.
     Declared inside: Astro hoists getStaticPaths into its own scope, so it
     cannot see module-level consts. */
  const bespoke = new Set(["seo"]);

  const services = await getCollection("services", ({ id }) => !bespoke.has(id));
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
};

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const { Content } = await render(service);
const { title, description, includes, faq } = service.data;

const url = `${SITE.url}/services/${service.id}/`;

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    description,
    url,
    serviceType: title,
    areaServed: "Europe",
    provider: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: `${SITE.url}/services/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];

if (faq.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}
---

<Base title={`${title} | ${SITE.name}`} description={description} schema={schema}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <a href="/services/">Services</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <header class="page-head">
      <span class="kicker">Services</span>
      <h1 class="page-head__title">{title}</h1>
      <p class="page-head__lede">{description}</p>
      <div class="hero__actions">
        <a class="btn btn-primary btn--lg" href="/contact/">Book a strategy call</a>
      </div>
    </header>

    <div class="article-grid">
      <div class="prose">
        <Content />
      </div>

      {
        includes.length > 0 && (
          <aside class="includes">
            <h2 class="kicker">What's included</h2>
            <ul class="includes__list">
              {includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      faq.length > 0 && (
        <section class="section section--ruled">
          <h2 class="kicker">Common questions</h2>
          <div class="faq">
            {faq.map((item) => (
              <details class="faq__item">
                <summary class="faq__q">{item.q}</summary>
                <p class="faq__a">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <CtaBanner />
</Base>
