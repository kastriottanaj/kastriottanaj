---
import Base from "../layouts/Base.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { SITE } from "../lib/site";
import "../styles/process.css";

const title = "SEO & Automation Process: Audit, Build & Reporting";
const description =
  "See the five-step SEO and AI automation process that grows traffic, wins qualified leads, and cuts manual work. Book a strategy call.";

const heroImage = "/assets/process/process-kastriot-tanaj.webp";

/** One source for the timeline band and the detailed section below it. */
const phases = [
  {
    num: "01",
    icon: "i-search",
    title: "Discover & audit",
    short:
      "Full technical crawl, content review and competitor analysis to find what's holding growth back.",
    body: "Nothing gets touched until I know what is actually wrong. I crawl the site, read the search data you already have, and look at the two or three competitors who keep outranking you. What comes back is a list of problems ranked by what they are costing you — not a severity score out of ten that nobody can act on.",
    deliverables: [
      "Full technical crawl and fix list",
      "On-page and content review",
      "Competitor gap analysis",
      "Findings ranked by impact, not by tool score",
    ],
  },
  {
    num: "02",
    icon: "i-map",
    title: "Strategy & roadmap",
    short:
      "A prioritised plan with quick wins and bigger bets tied to traffic, leads and revenue.",
    body: "The audit says what is broken. The roadmap says what we do about it, in what order, and what each item is expected to move. Everything ties back to one goal you pick, because a plan that optimises for traffic, leads and revenue at once optimises for none of them. Work that costs a lot and moves little gets cut here, not halfway through the quarter.",
    deliverables: [
      "Keyword and topic map",
      "Prioritised 90-day roadmap",
      "Agreed success metrics",
      "Effort and impact estimate per item",
    ],
  },
  {
    num: "03",
    icon: "i-sliders",
    title: "Build & optimise",
    short:
      "Technical fixes, content and internal linking to strengthen visibility and relevance.",
    body: "This is the part most audits never reach. Technical fixes get implemented, pages get rewritten and restructured, new content gets published, and internal linking gets rebuilt around the topics you want to own. I work inside your site or alongside your developers — whichever ships faster. Every change is logged with a date, so a movement three months later can be traced back to a cause.",
    deliverables: [
      "Technical fixes implemented and verified",
      "On-page and content rewrites",
      "New pages and content shipped",
      "A dated change log you keep",
    ],
  },
  {
    num: "04",
    icon: "i-bot",
    title: "Automate & scale",
    short: "Workflows, alerts and processes that save time and remove manual work.",
    body: "Once the work is running, the recurring parts get handed to a machine — reporting, lead routing, content briefs, alerts when something breaks. These are custom Python and AI workflows built around the tools you already use, not another subscription to manage. The test is simple: hours back every month, and fewer things that quietly stop working.",
    deliverables: [
      "Automation scoped to your stack",
      "Built, tested and documented",
      "Handover so your team can run it",
      "Monitoring for silent failures",
    ],
  },
  {
    num: "05",
    icon: "i-phone",
    title: "Track & report",
    short: "Clear monthly reporting showing what changed, what it did, and what's next.",
    body: "Monthly reporting a non-marketer can read: what changed, what it did, what is next, and what did not work. Impressions climbing while leads stay flat is a finding worth leading with, not something to bury on slide fourteen. If a bet did not pay off, you hear it from me first.",
    deliverables: [
      "Monthly report in plain language",
      "Rankings, traffic and lead tracking",
      "What worked and what didn't",
      "Next month's priorities",
    ],
  },
];

const strip = [
  { icon: "i-target", label: "5 focused phases" },
  { icon: "i-wrench", label: "Hands-on implementation" },
  { icon: "i-bar-chart", label: "Plain-language reporting" },
];

const values = [
  {
    icon: "i-search",
    title: "See what is blocking growth",
    desc: "A technical, content and competitor audit ranked by impact.",
  },
  {
    icon: "i-map",
    title: "Know exactly what happens next",
    desc: "A prioritised roadmap tied to traffic, leads and revenue.",
  },
  {
    icon: "i-rocket",
    title: "Get work shipped, not just advised",
    desc: "SEO fixes, content and automations implemented and measured.",
  },
];

const youGet = [
  "Priorities ranked by impact",
  "Changes logged",
  "Monthly report",
  "Next actions",
];

const offers = [
  {
    icon: "i-search",
    title: "SEO",
    desc: "Technical fixes, content and internal linking that build visibility and qualified organic traffic.",
    href: "/services/seo/",
  },
  {
    icon: "i-megaphone",
    title: "Digital marketing",
    desc: "Campaigns and content that attract the right audience and turn interest into leads.",
    href: "/services/digital-marketing/",
  },
  {
    icon: "i-bot",
    title: "AI automation",
    desc: "Automations that remove manual work, speed up follow-up and keep things moving.",
    href: "/services/ai-automation/",
  },
];

const timeline = [
  {
    icon: "i-search",
    label: "Weeks 1–2",
    title: "Audit and roadmap",
    desc: "From the first call to a plan you could act on without me.",
  },
  {
    icon: "i-sliders",
    label: "Weeks 3–12",
    title: "Build and optimise",
    desc: "Fixes and content ship continuously. The first real movement in search usually lands in this window.",
  },
  {
    icon: "i-trending",
    label: "Month 3 onward",
    title: "Compound and automate",
    desc: "Rankings mature, reporting runs itself, and the roadmap gets rewritten against what actually moved.",
  },
];

const fromYou = [
  {
    icon: "i-sliders",
    title: "Access",
    desc: "Search Console, Analytics and the CMS. Read-only is fine to start with.",
  },
  {
    icon: "i-users",
    title: "One decision-maker",
    desc: "One person who can approve copy and say yes to shipping. Approval by committee is what actually kills timelines.",
  },
  {
    icon: "i-phone",
    title: "An hour a month",
    desc: "One call to review what moved and agree what's next. Everything else can be async.",
  },
  {
    icon: "i-trending",
    title: "Honesty about the goal",
    desc: "Traffic, leads or revenue. Tell me which one you're measured on and I'll optimise for that one.",
  },
];

const faq = [
  {
    q: "How soon will I see results?",
    a: "Technical and on-page fixes can show up within weeks. Competitive rankings usually take three to six months of consistent work. I would rather tell you that now than explain it in month four.",
  },
  {
    q: "Do you work with my developers, or replace them?",
    a: "Either. If you have a dev team, I hand them scoped tickets and verify the result. If you don't, I implement the changes directly.",
  },
  {
    q: "What if I only want the audit?",
    a: "That's the SEO Audit & Sprint package. You get the findings and the roadmap, and you're free to run it in-house or with another team.",
  },
  {
    q: "Who actually does the work?",
    a: "I do. You are not being sold to by one person and then handed to someone else.",
  },
  {
    q: "Does this work outside SEO?",
    a: "The same five phases run for digital marketing, automation and web builds. What changes is what gets audited in phase one and what gets shipped in phase three.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Process", item: `${SITE.url}/process/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How I work with clients",
    description,
    url: `${SITE.url}/process/`,
    step: phases.map((phase, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      name: phase.title,
      text: phase.body,
      url: `${SITE.url}/process/#phase-${phase.num}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base title={title} description={description} image={heroImage} schema={schema}>
  <div class="process-page">
    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="process-hero" aria-labelledby="process-title">
      <img
        class="process-hero__image"
        src={heroImage}
        width="1774"
        height="887"
        alt="A laptop showing an SEO dashboard and an automation workflow"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <div class="process-wrap process-hero__inner">
        <p class="process-eyebrow">A clear, hands-on process</p>
        <h1 class="process-hero__title" id="process-title">
          SEO &amp; Automation That Grows Traffic and Cuts Manual Work
        </h1>
        <p class="process-hero__lede">
          For businesses that need more qualified leads and leaner operations — from audit
          to implementation and clear monthly reporting.
        </p>
        <div class="process-hero__actions">
          <a
            class="process-button process-button--primary"
            href={SITE.whatsappUrl}
            target="_blank"
            rel="noopener"
          >Book a strategy call</a>
          <a class="process-button process-button--ghost" href="/pricing/">See packages</a>
        </div>
        <ul class="process-trust">
          <li>No black box</li>
          <li>No vague retainers</li>
          <li>Work you can track</li>
        </ul>
      </div>
    </section>

    <!-- ── Capability strip ─────────────────────────────────────────────── -->
    <section class="process-strip" aria-label="How the engagement runs">
      <ul class="process-wrap process-strip__list">
        {
          strip.map((item) => (
            <li>
              <svg aria-hidden="true"><use href={`#${item.icon}`} /></svg>
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── What the process gives you ───────────────────────────────────── -->
    <section class="process-values" aria-label="What the process gives you">
      <ul class="process-wrap process-values__list">
        {
          values.map((value) => (
            <li class="process-value">
              <svg class="process-value__icon" aria-hidden="true">
                <use href={`#${value.icon}`} />
              </svg>
              <h3>{value.title}</h3>
              <p>{value.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── The five phases ──────────────────────────────────────────────── -->
    <section class="process-phases" aria-labelledby="phases-title">
      <div class="process-wrap process-phases__grid">
        <div>
          <h2 class="process-phases__title" id="phases-title">
            Five phases. One accountable process.
          </h2>
          <ol class="process-timeline">
            {
              phases.map((phase) => (
                <li class="process-phase">
                  <p class="process-phase__num">{phase.num}</p>
                  <h3>{phase.title}</h3>
                  <p class="process-phase__desc">{phase.short}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="process-gets">
          <h3>What you get</h3>
          <ul>
            {
              youGet.map((item) => (
                <li>
                  <svg aria-hidden="true"><use href="#i-check-circle" /></svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Where the phases get applied ─────────────────────────────────── -->
    <section class="process-offer" aria-label="Where the process gets applied">
      <div class="process-wrap process-offer__grid">
        {
          offers.map((offer) => (
            <article class="process-card">
              <div class="process-card__head">
                <svg aria-hidden="true"><use href={`#${offer.icon}`} /></svg>
                <h3>{offer.title}</h3>
              </div>
              <p>{offer.desc}</p>
              <a class="process-link" href={offer.href}>Explore service →</a>
            </article>
          ))
        }

        <article class="process-case">
          <div class="process-case__body">
            <p class="process-eyebrow">Case study</p>
            <h3>From buried visibility to rankings you can point at</h3>
            <p class="process-case__desc">
              Real projects run through the same five phases — the fixes, the content, and
              the numbers that actually moved.
            </p>
            <a class="process-link" href="/work/">View case studies →</a>
          </div>
          <img
            src="/assets/process/process-of-work-seo.webp"
            width="1672"
            height="941"
            alt="A laptop and tablet showing search performance and automation dashboards"
            loading="lazy"
            decoding="async"
          />
        </article>
      </div>
    </section>

    <!-- ── Phase detail ─────────────────────────────────────────────────── -->
    <section class="process-detail process-wrap" aria-labelledby="detail-title">
      <div class="process-detail__head">
        <p class="process-eyebrow">Inside each phase</p>
        <h2 class="process-detail__title" id="detail-title">What actually happens, step by step</h2>
        <p class="process-detail__lede">
          No black boxes and no sixty-page deck nobody reads: you see what I found, what I'd
          do about it, and what it moved.
        </p>
      </div>

      <ol class="process-steps">
        {
          phases.map((phase) => (
            <li class="process-step" id={`phase-${phase.num}`}>
              <p class="process-step__num">{phase.num}</p>
              <div class="process-step__body">
                <h3>{phase.title}</h3>
                <p>{phase.body}</p>
              </div>
              <ul class="process-step__gets">
                {phase.deliverables.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── How long it takes ────────────────────────────────────────────── -->
    <section class="process-detail process-wrap" aria-labelledby="timing-title">
      <div class="process-detail__head">
        <p class="process-eyebrow">How long it takes</p>
        <h2 class="process-detail__title" id="timing-title">A realistic timeline</h2>
        <p class="process-detail__lede">
          SEO is not paid advertising. Technical fixes can move things in weeks; competitive
          rankings take months. Anyone promising page one by Friday is selling something else.
        </p>
      </div>

      <ul class="process-tiles">
        {
          timeline.map((item) => (
            <li class="process-tile">
              <svg aria-hidden="true"><use href={`#${item.icon}`} /></svg>
              <p class="process-tile__label">{item.label}</p>
              <h3>{item.title}</h3>
              <p class="process-tile__desc">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── What I need from you ─────────────────────────────────────────── -->
    <section class="process-detail process-wrap" aria-labelledby="from-you-title">
      <div class="process-detail__head">
        <p class="process-eyebrow">What I need from you</p>
        <h2 class="process-detail__title" id="from-you-title">Short list, and it stays short</h2>
        <p class="process-detail__lede">
          The work stalls far more often on access and approvals than on strategy.
        </p>
      </div>

      <ul class="process-tiles">
        {
          fromYou.map((item) => (
            <li class="process-tile">
              <svg aria-hidden="true"><use href={`#${item.icon}`} /></svg>
              <h3>{item.title}</h3>
              <p class="process-tile__desc">{item.desc}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
    <section class="process-detail process-wrap" aria-labelledby="faq-title">
      <div class="process-detail__head">
        <p class="process-eyebrow">Common questions</p>
        <h2 class="process-detail__title" id="faq-title">Before you book the call</h2>
      </div>

      <div class="process-faq">
        {
          faq.map((item) => (
            <details class="process-faq__item">
              <summary class="process-faq__q">{item.q}</summary>
              <p class="process-faq__a">{item.a}</p>
            </details>
          ))
        }
      </div>

      <p class="process-next">
        See what the phases cost in <a href="/pricing/">packages and pricing</a>, or look at
        how this played out on real projects in the <a href="/work/">case studies</a>.
      </p>
    </section>
  </div>

  <CtaBanner />

  <a
    class="process-contact-bar"
    href={SITE.whatsappUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Contact ${SITE.name} on WhatsApp`}
  >Contact</a>
</Base>
