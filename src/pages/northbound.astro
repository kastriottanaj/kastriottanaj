---
import { SITE } from "../lib/site";
import { shareCard } from "../lib/og.mjs";
import "../styles/northbound.css";
import "../styles/northbound-polish.css";

// Falls back to the committed 1080p web encode; the 4K master is gitignored.
const canonical = new URL(Astro.url.pathname, SITE.url).href;

// This page writes its own <head> rather than going through Base, so its Open
// Graph tags are here too — under its own brand, not Kastriot's. The card comes
// off the hero poster, the only still frame the page has.
const description = "Private, tailor-made journeys through Shkodër and Northern Albania.";
const card = shareCard("/video/shkoder-poster.jpg");
const ogImage = new URL(card.url, SITE.url).href;

const heroVideoUrl = import.meta.env.PUBLIC_HERO_VIDEO_URL || "/video/shkoder-web-1080p.mp4";
const heroPosterUrl = import.meta.env.PUBLIC_HERO_POSTER_URL || "/video/shkoder-poster.jpg";

const regions = [
  { name: "Theth", note: "High trails & stone towers", cls: "theth" },
  { name: "Shkodër", note: "The city at the lake", cls: "shkoder" },
  { name: "Koman", note: "Water through the mountains", cls: "koman" },
  { name: "Valbonë", note: "A valley without edges", cls: "valbona" },
];
const journeys = [
  { nights: "7 nights", place: "Theth · Valbonë", title: "Across the Accursed Mountains", text: "A private crossing of Albania’s wild north, softened by fireside tables and mountain guesthouses." },
  { nights: "5 nights", place: "Shkodër · Koman", title: "Where the river finds the lake", text: "Old streets, quiet water and a slow voyage into the limestone folds of Koman." },
  { nights: "9 nights", place: "North to coast", title: "From alpine path to Adriatic blue", text: "A beautifully paced journey from remote peaks to the warm, unhurried edge of the sea." },
];
---
<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#17231d" /><title>Northbound Albania — Private journeys into the wild north</title>
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Northbound Albania" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content="Northbound Albania — Private journeys into the wild north" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content={card.type} />
  <meta property="og:image:width" content={String(card.width)} />
  <meta property="og:image:height" content={String(card.height)} />
  <meta property="og:image:alt" content="An aerial view of Rozafa Castle above Shkodër, its stone walls and ramparts ringed by pines" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image:alt" content="An aerial view of Rozafa Castle above Shkodër, its stone walls and ramparts ringed by pines" />
  {heroPosterUrl && <link rel="preload" as="image" href={heroPosterUrl} fetchpriority="high" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Italiana&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav" data-nav>
    <a class="brand" href="#top" aria-label="Northbound Albania home"><svg viewBox="0 0 48 36" aria-hidden="true"><path d="M3 31 15 8l7 12L29 4l16 27M11 31h29" /></svg><span>NORTHBOUND<small>ALBANIA</small></span></a>
    <nav class="nav__links" aria-label="Main navigation"><a href="#places">Places</a><a href="#journeys">Journeys</a><a href="#story">Our story</a></nav>
    <a class="nav__enquire" href="#contact">Plan my journey <span>↗</span></a>
    <button class="nav__toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
  </header>
  <main id="main">
    <section class="hero" id="top">
      <div class="hero__fallback"></div>{heroPosterUrl && <img class="hero__poster" src={heroPosterUrl} alt="" fetchpriority="high" />}<video class="hero__video" autoplay muted loop playsinline preload="auto" poster={heroPosterUrl}><source src={heroVideoUrl} type="video/mp4" /></video><div class="hero__shade"></div><div class="hero__loader"><span></span><small>Loading Shkodër</small></div>
      <div class="hero__content"><p class="eyebrow">Private journeys · Northern Albania</p><h1>Go where the<br /><em>mountains remember.</em></h1><p class="hero__copy">We create rare, deeply local journeys through Shkodër and Albania’s untamed north.</p><a class="button button--light" href="#journeys">Begin your journey <span>→</span></a></div>
      <div class="hero__foot"><span>42.0693° N &nbsp; 19.5033° E</span><a href="#story">Scroll to discover <b>↓</b></a><button class="sound" aria-label="Toggle video sound">Sound off</button></div>
    </section>
    <section class="intro" id="story">
      <p class="section-no">01 / Our north</p><div class="intro__body"><div><p class="eyebrow eyebrow--dark">A different kind of luxury</p><h2>Not more things.<br /><em>More feeling.</em></h2></div><div class="intro__copy"><p>Beyond the familiar map lies a place of glacial rivers, generous tables and roads that rise into silence. We know it by heart.</p><p>Every Northbound journey is made from scratch—guided by local people, shaped around your rhythm, and full of the moments no itinerary can promise.</p><a class="text-link" href="#contact">How we travel <span>↗</span></a></div></div>
      <div class="intro__marquee" aria-hidden="true">WILD BY NATURE · WARM BY HEART ·</div>
    </section>
    <section class="places" id="places">
      <div class="section-head"><div><p class="eyebrow">Choose your horizon</p><h2>Four ways into<br /><em>the north.</em></h2></div><p>From Ottoman streets to high mountain passes, each place opens a different door into Albania.</p></div>
      <div class="place-grid">{regions.map((region, i) => <a class={`place-card place-card--${region.cls}`} href="#journeys">{region.cls === "shkoder" && <video data-scenic-video muted loop playsinline preload="none" poster={heroPosterUrl}><source src={heroVideoUrl} type="video/mp4" /></video>}<span class="place-card__num">0{i + 1}</span><span class="place-card__copy"><strong>{region.name}</strong><small>{region.note}</small></span><span class="place-card__arrow">↗</span></a>)}</div>
    </section>
    <section class="quote"><svg viewBox="0 0 60 44" aria-hidden="true"><path d="M5 38c8-2 12-7 12-14H5V5h20v17c0 12-6 19-20 22V38Zm30 0c8-2 12-7 12-14H35V5h20v17c0 12-6 19-20 22V38Z" /></svg><blockquote>“The road ends. The journey finally begins.”</blockquote><p>— An old northern saying</p></section>
    <section class="journeys" id="journeys">
      <div class="journeys__top"><p class="section-no">02 / Signature journeys</p><div><h2>Journeys with<br /><em>a sense of place.</em></h2><p>Our favourite ways to experience Northern Albania. Each is only a beginning—we’ll shape every detail around you.</p></div></div>
      <div class="journey-grid">{journeys.map((journey, i) => <article class={`journey-card journey-card--${i + 1}`}><div class="journey-card__visual"><video data-scenic-video muted loop playsinline preload="none" poster={heroPosterUrl}><source src={heroVideoUrl} type="video/mp4" /></video><span>{journey.nights}</span></div><div class="journey-card__body"><p>{journey.place}</p><h3>{journey.title}</h3><div><span>{journey.text}</span><a href="#contact" aria-label={`Explore ${journey.title}`}>↗</a></div></div></article>)}</div>
    </section>
    <section class="promise"><div class="promise__visual"><video data-scenic-video muted loop playsinline preload="none" poster={heroPosterUrl}><source src={heroVideoUrl} type="video/mp4" /></video><span>Shkodër<br />at first light</span></div><div class="promise__copy"><p class="eyebrow eyebrow--dark">Made personal</p><h2>Your Albania.<br /><em>Never off the shelf.</em></h2><p>Tell us what draws you north. A family reunion, a summit at sunrise, a long table beneath the vines—we build from the feeling, then handle every detail.</p><ul><li><b>01</b> Local experts, always</li><li><b>02</b> Private guides & stays</li><li><b>03</b> Support from arrival to farewell</li></ul><a class="button button--dark" href="#contact">Meet your travel designer <span>→</span></a></div></section>
    <section class="contact" id="contact"><div class="contact__inner"><p class="eyebrow">Your story starts here</p><h2>Ready to head north?</h2><p>Share a little about the journey you imagine. We’ll return with ideas worth travelling for.</p><form class="contact__form" action="mailto:kastriot@kastriottanaj.com" method="post" enctype="text/plain" data-email-form><label><span>Your name</span><input name="name" autocomplete="name" placeholder="Full name" maxlength="100" required /></label><label><span>Email address</span><input type="email" name="email" autocomplete="email" placeholder="you@example.com" maxlength="200" required /></label><label><span>What calls you north?</span><select name="service"><option>Mountains & hiking</option><option>Culture & food</option><option>Family journey</option><option>A little of everything</option></select></label><label class="contact__message"><span>Tell us a little more</span><textarea name="message" placeholder="Dates, people, dreams…" maxlength="5000" required></textarea></label><button type="submit">Start planning <span>↗</span></button></form><p class="contact__prototype">Concept preview · Opens a pre-filled email enquiry</p></div></section>
  </main>
  <footer><div class="footer__brand"><span>NORTHBOUND</span><small>ALBANIA</small><p>Private journeys through Albania’s wild north.</p></div><div><p>Explore</p><a href="#places">Places</a><a href="#journeys">Journeys</a><a href="#story">Our story</a></div><div><p>Find us</p><a href="#">Instagram</a><a href="#">WhatsApp</a><a href="mailto:hello@northbound.al">Email</a></div><div class="footer__end"><p>Shkodër, Albania</p><span>© 2026 Northbound Albania</span></div></footer>
  <script>
    const nav = document.querySelector('[data-nav]'); const toggle = document.querySelector('.nav__toggle');
    toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('is-open'); toggle.setAttribute('aria-expanded', String(Boolean(open))); });
    document.querySelectorAll('.nav__links a').forEach(a => a.addEventListener('click', () => nav?.classList.remove('is-open')));
    const hero = document.querySelector('.hero'); const heroVideo = document.querySelector('.hero__video'); const sound = document.querySelector('.sound');
    const play = (video: HTMLVideoElement) => { const promise = video.play(); if (promise) promise.catch(() => {}); };
    if (heroVideo instanceof HTMLVideoElement) {
      heroVideo.muted = true; heroVideo.defaultMuted = true;
      heroVideo.addEventListener('playing', () => hero?.classList.add('is-ready'));
      heroVideo.addEventListener('canplay', () => play(heroVideo));
      play(heroVideo);
      addEventListener('pageshow', () => play(heroVideo));
      document.addEventListener('visibilitychange', () => { if (!document.hidden) play(heroVideo); });
      document.addEventListener('pointerdown', () => play(heroVideo), { once: true });
      document.addEventListener('keydown', () => play(heroVideo), { once: true });
    }
    const scenicVideos = document.querySelectorAll('[data-scenic-video]');
    const videoObserver = new IntersectionObserver(entries => entries.forEach(entry => { const video = entry.target; if (!(video instanceof HTMLVideoElement)) return; if (entry.isIntersecting) play(video); else video.pause(); }), { rootMargin: '200px 0px', threshold: .05 });
    scenicVideos.forEach(video => videoObserver.observe(video));
    sound?.addEventListener('click', () => { if (!(heroVideo instanceof HTMLVideoElement)) return; heroVideo.muted = !heroVideo.muted; sound.textContent = heroVideo.muted ? 'Sound off' : 'Sound on'; play(heroVideo); });
    addEventListener('scroll', () => nav?.classList.toggle('is-scrolled', scrollY > 40), { passive: true });
    const revealTargets = document.querySelectorAll('.intro__body, .section-head, .place-card, .quote, .journeys__top, .journey-card, .promise__copy');
    revealTargets.forEach(el => el.classList.add('reveal'));
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .12 });
    revealTargets.forEach(el => observer.observe(el));
    const form = document.querySelector('.contact__form');
    form?.addEventListener('submit', event => { event.preventDefault(); if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return; const data = new FormData(form); const subject = `Northbound Albania enquiry — ${String(data.get('name') || '')}`; const body = [`Name: ${data.get('name')}`, `Email: ${data.get('email')}`, `Interest: ${data.get('service')}`, '', String(data.get('message') || '')].join('\n'); window.location.href = `mailto:kastriot@kastriottanaj.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`; });
  </script>
</body></html>
