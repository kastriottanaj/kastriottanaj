---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { SITE, SOCIAL_URLS } from "../lib/site";
import "../styles/contact.css";

const title = `Contact an SEO & AI Automation Expert — ${SITE.name}`;
const description =
  "Discuss SEO, digital marketing, AI automation or web development in Pristina and across Europe. Send your details for a free 20-minute call.";

const proofPoints = [
  { icon: "i-pin", text: "Based in Pristina" },
  { icon: "i-globe", text: "Working across Europe" },
  { icon: "i-file-text", text: "Scope and price in writing" },
];

const benefits = [
  {
    icon: "i-search",
    title: "Advice built around your site",
    description: "A quick review before recommendations.",
  },
  {
    icon: "i-clipboard-list",
    title: "Clear next steps",
    description: "One focused plan, not a generic pitch deck.",
  },
  {
    icon: "i-shield-check",
    title: "No pressure to proceed",
    description: "Approve the scope before any work starts.",
  },
];

const services = [
  { icon: "i-search", title: "SEO & content", href: "/services/seo/" },
  { icon: "i-bot", title: "AI automation", href: "/services/ai-automation/" },
  { icon: "i-monitor", title: "Website redesign", href: "/services/web-development/" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Contact", item: `${SITE.url}/contact/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    url: `${SITE.url}/contact/`,
    name: "Contact",
    description,
    mainEntity: {
      "@type": "Person",
      name: SITE.name,
      url: `${SITE.url}/`,
      jobTitle: SITE.jobTitle,
      telephone: SITE.phone,
      sameAs: SOCIAL_URLS,
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.locality,
        addressCountry: SITE.country,
      },
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        telephone: SITE.phone,
        areaServed: "Europe",
        availableLanguage: ["English", "Albanian"],
      },
    },
  },
];
---

<Base
  title={title}
  description={description}
  image="/assets/contact/kastriot-tanaj-contact.webp"
  schema={schema}
>
  <div class="contact-page">
    <section class="contact-hero" id="contact" aria-labelledby="contact-title">
      <div class="contact-hero__backdrop" aria-hidden="true"></div>

      <div class="contact-hero__inner">
        <div class="contact-hero__copy">
          <p class="contact-eyebrow">SEO + AI AUTOMATION</p>
          <h1 class="contact-hero__title" id="contact-title">
            SEO and AI automation<br />
            that grow traffic and cut<br />
            manual work
          </h1>
          <p class="contact-hero__lede">
            For European businesses that need more<br class="contact-hero__lede-break--mobile" />
            qualified<br class="contact-hero__lede-break" /> leads, better search visibility,
            or<br class="contact-hero__lede-break--mobile" /> hours back every month.
          </p>

          <div class="contact-hero__actions">
            <a class="contact-button contact-button--primary" href="#contact-form">
              Start your project
            </a>
            <a
              class="contact-button contact-button--outline"
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener"
            >
              <svg class="contact-button__whatsapp" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.8 11.8 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.82 11.82 0 0 0 20.465 3.488" />
              </svg>
              Message on WhatsApp
            </a>
          </div>

          <p class="contact-hero__meta">
            <svg aria-hidden="true"><use href="#i-clock" /></svg>
            <span>
              Free 20-minute call&nbsp; · &nbsp;Reply within
              <br class="contact-hero__meta-break" />2 business days
            </span>
          </p>
        </div>

        <div class="contact-form-card">
          <h2>Tell me about your project</h2>
          <ContactForm projectBrief />
        </div>
      </div>
    </section>

    <section class="contact-proof" aria-label="Project details">
      <ul class="contact-proof__inner">
        {
          proofPoints.map((point) => (
            <li>
              <svg aria-hidden="true"><use href={`#${point.icon}`} /></svg>
              <span>{point.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="contact-content">
      <section aria-label="What to expect">
        <ul class="contact-benefits">
          {
            benefits.map((benefit) => (
              <li>
                <svg aria-hidden="true"><use href={`#${benefit.icon}`} /></svg>
                <div>
                  <h2>{benefit.title}</h2>
                  <p>{benefit.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="contact-results" aria-label="Results and services">
        <article class="contact-outcome">
          <p class="contact-eyebrow">Outcome</p>
          <h2>Outranked a 10+ year<br />competitor in 2 months</h2>
          <p>SEO strategy, content and technical fixes.</p>
          <a href="/work/">See the case study&nbsp; →</a>
        </article>

        <ul class="contact-services">
          {
            services.map((service) => (
              <li>
                <a href={service.href}>
                  <svg aria-hidden="true"><use href={`#${service.icon}`} /></svg>
                  <strong>{service.title}</strong>
                  <span>Explore&nbsp; →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <CtaBanner
    title="Ready to grow traffic and save time?"
    lede=""
    ghostLabel={null}
  />

  <a
    class="contact-bar"
    href={SITE.whatsappUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Contact ${SITE.name} on WhatsApp`}
  >
    <svg aria-hidden="true"><use href="#i-message" /></svg>
    <span>Contact</span>
  </a>
</Base>
