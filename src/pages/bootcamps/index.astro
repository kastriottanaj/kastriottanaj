---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";

const bootcamps = (await getCollection("bootcamps", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = `Bootcamps — learn SEO and AI automation | ${SITE.name}`;
const description =
  "Self-paced bootcamps on SEO and AI automation, taught from live client work rather than from what has been published about it.";

/** The cheapest tier is the one worth putting on a card — it sets the floor. */
const fromPrice = (bootcamp: (typeof bootcamps)[number]) => {
  const cheapest = Math.min(...bootcamp.data.tiers.map((tier) => tier.price));
  return new Intl.NumberFormat("en-GB", {
    style: "currency",
    currency: bootcamp.data.currency,
    maximumFractionDigits: 0,
  }).format(cheapest);
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Bootcamps", item: `${SITE.url}/bootcamps/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: bootcamps.map((bootcamp, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Course",
        name: bootcamp.data.title,
        description: bootcamp.data.description,
        url: `${SITE.url}/bootcamps/${bootcamp.id}/`,
        provider: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
      },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span>
      <span aria-current="page">Bootcamps</span>
    </nav>

    <header class="page-head">
      <span class="kicker">Bootcamps</span>
      <h1 class="page-head__title">Learn the work, or have it done</h1>
      <p class="page-head__lede">
        Most of my week is spent doing SEO and automation on client sites. The bootcamps are
        that same work, written down — the decisions, in the order I make them, with the real
        templates rather than tidied-up teaching versions.
      </p>
    </header>

    <section class="section section--ruled">
      <h2 class="sr-only">Available bootcamps</h2>
      <div
        class="ruled-grid ruled-grid--courses"
        style={`--course-cols: ${Math.min(bootcamps.length, 3)}`}
      >
        {
          bootcamps.map((bootcamp) => (
            <article class="service course-card">
              <svg class="icon" aria-hidden="true">
                <use href={`#${bootcamp.data.icon}`} />
              </svg>
              <h3 class="service__title">
                <a href={`/bootcamps/${bootcamp.id}/`}>{bootcamp.data.navLabel ?? bootcamp.data.title}</a>
              </h3>
              <p class="service__desc">{bootcamp.data.short}</p>
              <p class="course-card__meta">
                {bootcamp.data.format} · from {fromPrice(bootcamp)}
              </p>
              <a class="arrow-link arrow-link--sm service__more" href={`/bootcamps/${bootcamp.id}/`}>
                See what's inside →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section--ruled">
      <h2 class="kicker">How they work</h2>
      <div class="prose prose--narrow">
        <p>
          Every module is built the same way: here is the decision you are trying to make, here
          is how I make it, here is me making it on a real site, here is the exercise on yours.
          There is no cohort to wait for and no schedule to fall behind — you buy it once and it
          stays yours, updates included.
        </p>
        <p>
          If you get through the first fortnight and it has not given you something you can use,
          email me and I refund it. That is the whole policy.
        </p>
      </div>
    </section>
  </div>

  <CtaBanner
    title="Not sure a course is what you need?"
    lede="If you would rather the work was simply done, say so — I will tell you honestly which of the two is the better spend."
  />
</Base>
