---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { SITE } from "../../lib/site";

const bootcamps = (await getCollection("bootcamps", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = `Bootcamps — learn SEO and WordPress | ${SITE.name}`;
const description =
  "Self-paced SEO and WordPress bootcamps built from live client work — the same decisions, templates and workflows, at your own pace with lifetime access.";

/** The cheapest tier is the one worth putting on a card — it sets the floor. */
const fromPrice = (bootcamp: (typeof bootcamps)[number]) => {
  const cheapest = Math.min(...bootcamp.data.tiers.map((tier) => tier.price));
  return new Intl.NumberFormat("en-GB", {
    style: "currency",
    currency: bootcamp.data.currency,
    maximumFractionDigits: 0,
  }).format(cheapest);
};

/**
 * Card art and the card blurb live here rather than in the content files:
 * the entries carry a longer `short` written for the course pages, and these
 * cards want the two-line version the index was designed around.
 */
const CARD_ART: Record<string, { blurb: string[]; image: string; alt: string }> = {
  "seo-bootcamp": {
    /* Split where the design breaks it; the mobile rules drop the breaks. */
    blurb: ["Audit, fix, publish and earn links with", "a complete SEO workflow."],
    image: "/assets/bootcamps/seo-bootcamp.webp",
    alt: "A dark analytics panel with a search field and a rising bar chart",
  },
  "wordpress-bootcamp": {
    blurb: ["Build and launch a complete WordPress", "website you can maintain yourself."],
    image: "/assets/bootcamps/wordpress-bootcamp.webp",
    alt: "A code-brackets mark above a dark browser window wireframe",
  },
};

const cards = bootcamps.map((bootcamp) => ({
  entry: bootcamp,
  href: `/bootcamps/${bootcamp.id}/`,
  modules: bootcamp.data.modules.length,
  price: fromPrice(bootcamp),
  ...CARD_ART[bootcamp.id],
}));

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Bootcamps", item: `${SITE.url}/bootcamps/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: bootcamps.map((bootcamp, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Course",
        name: bootcamp.data.title,
        description: bootcamp.data.description,
        url: `${SITE.url}/bootcamps/${bootcamp.id}/`,
        provider: { "@type": "Person", name: SITE.name, url: `${SITE.url}/` },
      },
    })),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <div class="bc-page">
    <div class="bc-wrap">
      <section class="bc-hero" aria-labelledby="bc-title">
        <div class="bc-hero__copy">
          <p class="bc-eyebrow">Practical bootcamps</p>
          <h1 class="bc-hero__title" id="bc-title">
            Learn SEO &amp;<br class="bc-br--narrow" /> WordPress<br class="bc-br--wide" /> Skills<br
              class="bc-br--narrow"
            /> You Can Use on<br /> Real Client Sites
          </h1>
          <p class="bc-hero__lede">
            Follow the same decisions, templates<br class="bc-br--narrow" /> and workflows I
            use<br class="bc-br--wide" /> on client sites —<br class="bc-br--narrow" /> at your own
            pace, with lifetime access.
          </p>
          <div class="bc-hero__actions">
            <a class="bc-button" href="#choose">Explore the bootcamps</a>
            <a class="bc-arrow" href="#why">See how they work →</a>
          </div>
        </div>

        <figure class="bc-hero__visual">
          <img
            src="/assets/bootcamps/hero-course.webp"
            width="513"
            height="333"
            alt="A laptop on a dark desk showing an analytics dashboard, charts and code"
            fetchpriority="high"
          />
        </figure>
      </section>

      <ul class="bc-facts" aria-label="What every bootcamp includes">
        <li class="bc-fact">
          <svg class="bc-fact__icon" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <circle cx="11" cy="11" r="10.2"></circle>
            <path d="M11 5.5V11l3.6 2.3"></path>
          </svg>
          <span>Self-paced</span>
        </li>
        <li class="bc-fact">
          <svg class="bc-fact__icon" width="20" height="21" viewBox="0 0 20 21" aria-hidden="true">
            <path d="M10 0.9 19.1 5.5 10 10.1 0.9 5.5 10 0.9Z"></path>
            <path d="m0.9 10.5 9.1 4.6 9.1-4.6"></path>
            <path d="m0.9 15.4 9.1 4.7 9.1-4.7"></path>
          </svg>
          <span>10 modules</span>
        </li>
        <li class="bc-fact">
          <svg class="bc-fact__icon" width="22" height="11" viewBox="0 0 22 11" aria-hidden="true">
            <circle cx="5.6" cy="5.5" r="4.7"></circle>
            <circle cx="16.4" cy="5.5" r="4.7"></circle>
          </svg>
          <span>Lifetime access</span>
        </li>
        <li class="bc-fact">
          <svg class="bc-fact__icon" width="19" height="22" viewBox="0 0 19 22" aria-hidden="true">
            <path d="M9.5 0.9 1 3.8v7.6c0 5.4 5.7 8.6 8.5 9.7 2.8-1.1 8.5-4.3 8.5-9.7V3.8L9.5 0.9Z"
            ></path>
            <path d="m6.1 11.2 2.5 2.5 4.3-4.7"></path>
          </svg>
          <span>14-day refund policy</span>
        </li>
      </ul>

      <section class="bc-why" id="why" aria-labelledby="bc-why-title">
        <h2 class="bc-eyebrow bc-why__label" id="bc-why-title">Why these bootcamps</h2>
        <div class="bc-why__grid">
          <article class="bc-benefit">
            <svg class="bc-benefit__icon" width="29" height="33" viewBox="0 0 29 33" aria-hidden="true">
              <circle cx="14.5" cy="8" r="7"></circle>
              <path d="M1 32a13.5 13.5 0 0 1 27 0Z"></path>
            </svg>
            <div>
              <h3>Real client workflows</h3>
              <p>Learn the decisions behind the <br />work, not just theory.</p>
            </div>
          </article>

          <article class="bc-benefit">
            <svg class="bc-benefit__icon" width="28" height="33" viewBox="0 0 28 33" aria-hidden="true">
              <path d="M17.9 1H1v31h26V10.1L17.9 1Z"></path>
              <path d="M17.9 1v9.1H27"></path>
              <path d="M6.5 18.6h15M6.5 24.6h15"></path>
            </svg>
            <div>
              <h3>Templates included</h3>
              <p>Use the same practical resources <br />on your own sites.</p>
            </div>
          </article>

          <article class="bc-benefit">
            <svg class="bc-benefit__icon" width="33" height="33" viewBox="0 0 33 33" aria-hidden="true">
              <circle cx="16.5" cy="16.5" r="15.5"></circle>
              <path d="M16.5 8.4v8.1l5.5 3.5"></path>
            </svg>
            <div>
              <h3>Learn at your pace</h3>
              <p>No cohort, no deadlines, and <br />updates are included.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="bc-choose" id="choose" aria-labelledby="bc-choose-title">
        <h2 class="bc-eyebrow" id="bc-choose-title">Choose your bootcamp</h2>
        <div class="bc-cards">
          {
            cards.map((card) => (
              <article class="bc-card">
                <img
                  class="bc-card__art"
                  src={card.image}
                  width="120"
                  height="120"
                  alt={card.alt}
                  loading="lazy"
                />
                <div class="bc-card__body">
                  <h3 class="bc-card__title">
                    <a href={card.href}>{card.entry.data.navLabel ?? card.entry.data.title}</a>
                  </h3>
                  <p class="bc-card__blurb">
                    {card.blurb[0]}{" "}
                    <br />
                    {card.blurb[1]}
                  </p>
                  <p class="bc-card__meta">
                    <span>{card.modules} modules <i aria-hidden="true">·</i></span>
                    <span>Lifetime access <i aria-hidden="true">·</i></span>
                    <span>From {card.price}</span>
                  </p>
                  <span class="bc-card__more" aria-hidden="true">
                    See what's inside →
                  </span>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>

  <CtaBanner title="Not sure which bootcamp fits?" />

  <a class="bc-mobile-bar" href="#choose">Explore bootcamps</a>
</Base>

<style is:global>
  body:has(.bc-page) {
    --bc-red: var(--color-accent);
    --bc-ink: #191818;
    --bc-muted: #4a4a4a;
    --bc-meta: #6b6b6b;
    --bc-rule: #c6c5c4;
    --bc-card-line: #e5e4e3;
    background: #f8f7f5;
  }

  body:has(.bc-page) .whatsapp-fab { display: none; }

  .bc-page { color: var(--bc-ink); text-wrap: wrap; }
  .bc-wrap {
    width: min(100%, 1120px);
    margin-inline: auto;
    padding-inline: 56px;
  }

  .bc-eyebrow {
    margin: 0;
    color: var(--bc-red);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .bc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 513px;
    column-gap: 58px;
    align-items: start;
    padding-block: 32px 16px;
  }

  .bc-hero__copy { padding-top: 28px; }
  .bc-br--narrow { display: none; }
  .bc-hero__title {
    margin: 14px 0 0;
    font-size: 38px;
    line-height: 44.5px;
    letter-spacing: -0.025em;
  }
  .bc-hero__lede {
    margin: 14px 0 0;
    color: var(--bc-muted);
    font-size: 14.5px;
    line-height: 22px;
  }
  .bc-hero__actions {
    display: flex;
    align-items: center;
    gap: 27px;
    margin-top: 20px;
  }
  .bc-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 17px;
    background: var(--bc-red);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 12.2px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }
  .bc-button:hover { background: var(--color-accent-600); }
  .bc-arrow {
    color: var(--bc-red);
    font-family: var(--font-heading);
    font-size: 12.2px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }
  .bc-arrow:hover { text-decoration: underline; }

  .bc-hero__visual {
    width: 513px;
    height: 333px;
    margin: 0;
    overflow: hidden;
  }
  .bc-hero__visual img { width: 100%; height: 100%; object-fit: cover; }

  /* ── The four facts ──────────────────────────────────────────────────── */
  .bc-facts {
    /* Unequal tracks: the mockup's dividers sit where the labels leave room. */
    display: grid;
    grid-template-columns: 243.5fr 231.5fr 245.5fr 286.5fr;
    height: 73px;
    margin: 0;
    padding: 0;
    border-block: 1px solid var(--bc-rule);
    list-style: none;
  }
  .bc-fact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
  }
  .bc-facts { position: relative; }
  .bc-facts::before,
  .bc-facts::after { display: none; }
  .bc-fact + .bc-fact { position: relative; }
  .bc-fact + .bc-fact::before {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 18px;
    left: 0;
    border-left: 1px solid var(--bc-rule);
  }
  .bc-fact__icon {
    flex: none;
    fill: none;
    stroke: var(--bc-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Why these bootcamps ─────────────────────────────────────────────── */
  .bc-why { padding-block: 32px 0; scroll-margin-top: 76px; }
  .bc-why__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bc-why__grid {
    display: grid;
    grid-template-columns: 296.5fr 327fr 383.5fr;
  }
  .bc-benefit {
    min-width: 0;
    padding-left: 23px;
  }
  .bc-benefit + .bc-benefit { padding-left: 62px; border-left: 1px solid var(--bc-rule); }
  .bc-benefit__icon {
    display: block;
    fill: none;
    stroke: var(--bc-ink);
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bc-benefit h3 {
    margin: 15px 0 0;
    font-size: 16.3px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .bc-benefit p {
    margin: 8px 0 0;
    color: var(--bc-muted);
    font-size: 14.3px;
    line-height: 19px;
  }

  /* ── Choose your bootcamp ────────────────────────────────────────────── */
  .bc-choose { padding-block: 42px 0; scroll-margin-top: 76px; }
  .bc-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
    margin-top: 12px;
  }
  .bc-card {
    position: relative;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    column-gap: 21px;
    min-height: 165px;
    padding: 19px 18px 17px;
    border: 1px solid var(--bc-card-line);
    border-radius: 6px;
    background: #fbfaf9;
  }
  .bc-card__art {
    width: 120px;
    height: 120px;
    align-self: start;
    border-radius: 10px;
    object-fit: cover;
  }
  .bc-card__body { min-width: 0; padding-top: 3px; }
  .bc-card__title {
    margin: 0;
    font-size: 16px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .bc-card__title a { color: inherit; text-decoration: none; }
  .bc-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .bc-card__title a:hover { color: var(--bc-red); }
  .bc-card__blurb {
    margin: 8px 0 0;
    color: var(--bc-muted);
    font-size: 13px;
    line-height: 18px;
  }
  .bc-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 11px;
    margin: 15px 0 0;
    color: var(--bc-meta);
    font-family: var(--font-mono);
    font-size: 10.3px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .bc-card__meta i { font-style: normal; }
  .bc-card__more {
    display: block;
    margin-top: 17px;
    color: var(--bc-red);
    font-family: var(--font-heading);
    font-size: 12.3px;
    font-weight: 800;
    line-height: 1;
  }
  .bc-card:hover { border-color: var(--bc-rule); }
  .bc-card:hover .bc-card__more { text-decoration: underline; }

  /* ── The closing bar ─────────────────────────────────────────────────── */
  body:has(.bc-page) .cta { margin-top: 33px; background: var(--bc-red); }
  body:has(.bc-page) .cta__inner {
    width: min(100%, 1121px);
    min-height: 79px;
    align-items: center;
    padding: 19px 136px;
    flex-wrap: nowrap;
    gap: 24px;
  }
  body:has(.bc-page) .cta__title { margin: 0; font-size: 19px; line-height: 1.2; }
  body:has(.bc-page) .cta__lede,
  body:has(.bc-page) .cta__ghost { display: none; }
  body:has(.bc-page) .cta__btn {
    min-height: 41px;
    padding: 0 26px;
    border-radius: 3px;
    font-size: 12.5px;
  }

  .bc-mobile-bar { display: none; }

  /* ── Between the mockup's two widths ─────────────────────────────────── */
  @media (max-width: 1119px) and (min-width: 721px) {
    .bc-wrap { padding-inline: 32px; }
    .bc-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); column-gap: 40px; }
    .bc-hero__title { font-size: 38px; }
    .bc-hero__title br,
    .bc-hero__lede br { display: none; }
    .bc-hero__visual { width: 100%; height: auto; aspect-ratio: 513 / 333; }
    .bc-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .bc-fact { gap: 10px; font-size: 12.5px; }
    .bc-why__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bc-benefit + .bc-benefit { padding-left: 28px; }
    .bc-benefit p br { display: none; }
    .bc-hero__actions { flex-wrap: wrap; gap: 18px 27px; }
    .bc-button,
    .bc-arrow { white-space: nowrap; }
    .bc-card__blurb br { display: none; }
    body:has(.bc-page) .cta__inner { padding-inline: 32px; }
  }

  /* Two cards side by side stop working before the phone layout takes over. */
  @media (max-width: 880px) and (min-width: 721px) {
    .bc-cards { grid-template-columns: minmax(0, 1fr); }
    .bc-card { min-height: 0; }
  }

  /* ── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    body:has(.bc-page) { padding-bottom: calc(62px + env(safe-area-inset-bottom)); }

    .bc-wrap { width: 100%; padding-inline: 16px; }

    .bc-hero { display: block; padding: 0 0 22px; }
    .bc-hero__copy { padding-top: 22px; }
    .bc-hero__title {
      margin-top: 14px;
      font-size: 29.3px;
      line-height: 35.4px;
      letter-spacing: -0.028em;
    }
    .bc-hero__lede {
      margin-top: 7px;
      font-size: 15.9px;
      line-height: 23.4px;
    }
    .bc-br--narrow { display: inline; }
    .bc-br--wide { display: none; }
    .bc-hero__actions {
      width: max-content;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin-top: 14px;
    }
    .bc-button { min-height: 42px; padding: 0 22px; font-size: 14.5px; }
    .bc-arrow {
      margin-top: 15px;
      font-size: 13.9px;
      text-align: center;
    }
    .bc-hero__visual { display: none; }

    .bc-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 55px 64px;
      height: 121px;
    }
    .bc-fact {
      align-self: start;
      justify-content: flex-start;
      gap: 15px;
      padding-top: 18px;
      padding-left: 30px;
      font-size: 13px;
    }
    .bc-fact + .bc-fact::before { display: none; }
    .bc-facts::before,
    .bc-facts::after {
      content: "";
      display: block;
      position: absolute;
      left: 50%;
      border-left: 1px solid var(--bc-rule);
    }
    .bc-facts::before { top: 15px; height: 32px; }
    .bc-facts::after { top: 63px; height: 42px; }

    .bc-why { padding-top: 38px; }
    .bc-why__label {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
      margin-bottom: 21px;
      white-space: normal;
    }
    .bc-why__grid { display: block; }
    .bc-benefit {
      display: grid;
      grid-template-columns: 37px minmax(0, 1fr);
      column-gap: 28px;
      padding-left: 0;
      border-left: 0;
    }
    .bc-benefit + .bc-benefit {
      margin-top: 17px;
      padding-left: 0;
      border-left: 0;
    }
    .bc-benefit__icon { width: auto; height: 37px; margin-top: 2px; }
    .bc-benefit h3 { margin: 4px 0 0; font-size: 15px; }
    .bc-benefit p { margin-top: 0; font-size: 15px; line-height: 1.42; }

    .bc-choose { padding-top: 30px; }
    .bc-choose .bc-eyebrow { margin-left: 0; }
    .bc-cards { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 12px; }
    .bc-card {
      grid-template-columns: 110px minmax(0, 1fr);
      column-gap: 18px;
      min-height: 0;
      padding: 14px;
    }
    .bc-card__art { width: 110px; height: 104px; border-radius: 8px; }
    .bc-card__body { padding-top: 3px; }
    .bc-card__title { font-size: 15.8px; }
    /* The page-wide `text-wrap: pretty` re-breaks these lines; the design
       wants the plain greedy wrap. */
    .bc-card__blurb { margin-top: 8px; font-size: 14.5px; line-height: 20px; }
    .bc-card__blurb br { display: none; }
    .bc-card__meta { gap: 0 6px; margin-top: 13px; font-size: 10.2px; }
    .bc-card__more { margin-top: 16px; font-size: 14.1px; }

    body:has(.bc-page) .cta,
    body:has(.bc-page) .footer { display: none; }

    .bc-mobile-bar {
      position: fixed;
      z-index: 950;
      right: 0;
      bottom: 0;
      left: 0;
      min-height: calc(62px + env(safe-area-inset-bottom));
      display: flex;
      align-items: center;
      justify-content: center;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--bc-red);
      color: #fff;
      font-family: var(--font-heading);
      font-size: 17.5px;
      font-weight: 800;
      line-height: 1;
      text-decoration: none;
    }
    body:has(.cookie-consent:not([hidden])) .bc-mobile-bar { display: none; }
  }
</style>
