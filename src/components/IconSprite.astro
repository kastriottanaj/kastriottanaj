---
/**
 * The icon sprite, trimmed to what the page uses.
 *
 * Wrap the body in it: the slot is rendered first, scanned for
 * <use href="#i-…"> references, and only those symbols are emitted ahead of
 * it. The full set is 65 icons (~19 KB) and a typical page uses a dozen, so
 * inlining everything was more than half the HTML of every short page.
 *
 * An id that is not in src/assets/icons.svg fails the build rather than
 * rendering an empty box.
 */
import icons from "../assets/icons.svg?raw";

const body = await Astro.slots.render("default");

const symbols = new Map(
  Array.from(icons.matchAll(/<symbol id="([^"]+)"[\s\S]*?<\/symbol>/g), (m) => [m[1], m[0]]),
);
const used = new Set(Array.from(body.matchAll(/<use href="#([^"]+)"/g), (m) => m[1]));

const unknown = [...used].filter((id) => !symbols.has(id));
if (unknown.length) {
  throw new Error(
    `Unknown icon${unknown.length > 1 ? "s" : ""}: ${unknown.join(", ")} — add to src/assets/icons.svg`,
  );
}

const sprite = [...used].map((id) => symbols.get(id)).join("\n  ");
---

{sprite && <svg class="sprite" aria-hidden="true" focusable="false" set:html={sprite} />}
<Fragment set:html={body} />
