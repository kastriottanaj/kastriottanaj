---
import { COMPANY, SITE, SOCIALS } from "../lib/site";

// Rendered at build time — no client JS needed to keep the year current, since
// every deploy rebuilds. A stale year means a stale deploy, which is useful signal.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__legal">
      <p class="footer__copy">© {year} {SITE.name} — kastriottanaj.com</p>
      <p class="footer__copy footer__company">
        {/* The {" "} keeps "through" from running into the name: compressHTML drops
            the whitespace at a line break next to an expression. */}
        Commercial services, courses, and SaaS products are operated and billed through{" "}
        <span class="nowrap">{COMPANY.legalName} ({COMPANY.jurisdiction}, USA).</span>
      </p>
    </div>
    <div class="footer__links">
      <a class="footer__link" href="/use-cases/">Use cases</a>
      <a class="footer__link" href="/newsletter/">Newsletter</a>
      <a class="footer__link" href="/privacy/">Privacy</a>
      <a class="footer__link" href="/terms/">Terms</a>
      <button class="footer__link footer__button" type="button" data-cookie-settings>Cookie settings</button>
      <ul class="footer__socials">
        {
          SOCIALS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener"
                aria-label={`${SITE.name} on ${social.label}`}
              >
                <svg class="icon icon-brand" aria-hidden="true"><use href={social.icon} /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
