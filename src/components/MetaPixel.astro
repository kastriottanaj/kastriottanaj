---
import { META_PIXEL_ID } from "../lib/site";

/** Meta (Facebook) Pixel — audience building, retargeting and conversion measurement.
 *
 * Production only — `astro dev` renders nothing, so localhost browsing stays out
 * of the pixel's data.
 *
 * Consent: fbevents.js is not fetched at all until the visitor accepts. Only
 * the queueing stub is inlined, so fbq() stays callable from the first byte and
 * anything tracked before a choice waits in memory rather than reaching Meta.
 * site.js calls __loadMetaPixel() on accept, which flushes the queue.
 *
 * It used to load on every page and then call fbq('consent','revoke'), which
 * sent 105 KiB to every visitor including the ones who never answered the
 * banner — the bulk of Lighthouse's "reduce unused JavaScript".
 *
 * No <noscript> fallback image on purpose: it would fire for every no-JS visitor
 * with no way to honour the banner, and the banner itself needs JS to appear.
 */

// Baked in the way the GA tag in Base.astro is: the ID is a public identifier,
// and the production build runs on the server, where a repo constant needs no
// deploy-time configuration. PUBLIC_META_PIXEL_ID overrides it; setting that to
// an empty string switches the pixel off.
const raw = (import.meta.env.PUBLIC_META_PIXEL_ID ?? META_PIXEL_ID).trim();

// Pixel IDs are numeric. Anything else is a misconfiguration, and refusing it
// keeps the raw value out of the inline script below. Dev is excluded outright,
// so localhost browsing never lands in the real pixel's data.
const pixelId = import.meta.env.PROD && /^\d{6,20}$/.test(raw) ? raw : null;

/* Wrapped in an IIFE: the gtag block in Base.astro declares its own top-level
   `consentChoice`, and a second `let` of that name would be a SyntaxError. */
/* Meta's own snippet defines the stub and injects the <script> in one breath.
   These are split so the stub is always present and the network request is
   deferred: init and PageView queue up, and __loadMetaPixel() — called here for
   someone who already accepted, or by site.js the moment they do — fetches
   fbevents.js, which replays the queue on arrival. Never accepting means the
   queue is simply discarded at unload. */
const snippet = `(function(){
var f=window,b=document,n;
if(f.fbq)return;
n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];
f.__loadMetaPixel=function(){
if(f.__metaPixelRequested)return;
f.__metaPixelRequested=!0;
var t=b.createElement('script');t.async=!0;
t.src='https://connect.facebook.net/en_US/fbevents.js';
var s=b.getElementsByTagName('script')[0];
s.parentNode.insertBefore(t,s);
};
fbq('init','${pixelId}');
fbq('track','PageView');
var choice=null;
try{choice=localStorage.getItem('cookie-consent');}catch(_){}
if(choice==='accepted')f.__loadMetaPixel();
})();`;
---

{pixelId && <script is:inline set:html={snippet} />}
