---
import { NAV, SITE, SOCIALS } from "../lib/site";

const { pathname } = Astro.url;

/** A nav entry is current when its path prefix matches — /blog/ covers /blog/a-post/. */
function isCurrent(href: string) {
  if (href.startsWith("/#")) return false; // homepage anchors are handled by scroll-spy
  return pathname === href || (href !== "/" && pathname.startsWith(href));
}
---

<nav class="nav">
  <a class="nav-brand" href="/">{SITE.name}</a>

  <a
    class="nav__mobile-cta"
    href={SITE.whatsappUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Book a call with ${SITE.name} on WhatsApp at ${SITE.phoneDisplay}`}
  >Book a call</a>

  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
    <span class="nav__bars" aria-hidden="true"></span>
    <span>Menu</span>
  </button>

  <div class="nav__menu" id="nav-menu">
    <ul class="nav__links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="nav__socials">
      {
        SOCIALS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener"
              aria-label={`${SITE.name} on ${social.label}`}
            >
              <svg class="icon icon-brand" aria-hidden="true"><use href={social.icon} /></svg>
            </a>
          </li>
        ))
      }
    </ul>
    <a
      class="btn btn-primary"
      href={SITE.whatsappUrl}
      target="_blank"
      rel="noopener"
      aria-label={`Book a call with ${SITE.name} on WhatsApp at ${SITE.phoneDisplay}`}
    >Book a call</a>
  </div>
</nav>
