# kastriottanaj.com — Caddy site config
#
# Caddy serves the static build directly and hands only /api/* to Node. Static
# files never touch the Node process, and TLS certificates are obtained and
# renewed automatically.
#
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

# Canonical host is the apex — the site's <link rel="canonical"> says so.
www.kastriottanaj.com {
	redir https://kastriottanaj.com{uri} permanent
}

kastriottanaj.com {
	encode zstd gzip

	root * /var/www/kastriottanaj/current/dist/client

	# The one dynamic route. Caddy preserves the Host header and writes
	# X-Forwarded-For / X-Forwarded-Proto itself — it ignores whatever the
	# client sent for any X-Forwarded-* header, since no trusted_proxies is
	# configured — which is what lets Astro's origin check and the rate limiter
	# see the real client and scheme.
	#
	# CF-Connecting-IP gets no such treatment: it is not an X-Forwarded-* header,
	# so Caddy would hand it to Node exactly as a visitor typed it. Nothing reads
	# it any more (src/lib/request.ts), and stripping it here means nothing can
	# start again by accident. Restore it only alongside a real Cloudflare proxy
	# and deploy/cloudflare-lockdown.sh.
	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:4321 {
			header_up -CF-Connecting-IP
		}
	}

	handle {
		# Astro emits directory-style routes: /services/seo/ -> …/index.html
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# PDFs have no HTML <head>, so publish their canonical URL as an HTTP header.
	@cv path /assets/kastriot-tanaj-cv.pdf
	header @cv Link "<https://kastriottanaj.com/assets/kastriot-tanaj-cv.pdf>; rel=\"canonical\""

	# Fingerprinted assets are immutable — cache them hard.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate so a deploy is visible immediately.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Everything under public/ ships with a stable, hand-written name, so it
	# can't be immutable the way /_astro/* is — but without a header at all,
	# every repeat visitor re-downloaded the 3 MB hero clip (Lighthouse:
	# "use efficient cache lifetimes", 3,182 KiB).
	#
	# Consequence of the 30 days: swapping a video or image *in place* now
	# leaves returning visitors on the old file until it expires. Give the
	# replacement a new filename, or the reference a ?v= suffix.
	@public path /video/* /assets/* /og/* /favicon.ico
	header @public Cache-Control "public, max-age=2592000"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output file /var/log/caddy/kastriottanaj.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
