# Copy to /etc/kastriottanaj/env on the server (root-owned, chmod 600).
# Never commit the filled-in version.

# ── Northbound Albania media delivery ───────────────────────────────────────
# Public Vercel Blob URLs. Keep the original 4K master archived separately.
# PUBLIC_HERO_VIDEO_URL=https://example.public.blob.vercel-storage.com/travel/shkoder-web-1080p.mp4
# PUBLIC_HERO_POSTER_URL=https://example.public.blob.vercel-storage.com/travel/shkoder-poster.webp

# ── Email delivery (Hostinger SMTP) ──────────────────────────────────────────
# The mailbox the server authenticates as. Hostinger rejects a From address that
# does not match it, so this is also the address every email is sent from —
# enquiry notifications, newsletter opt-in mails, and the newsletter itself.
SMTP_HOST=smtp.hostinger.com
# STARTTLS on 587: Hetzner blocks outbound 25 and 465 on new Cloud accounts.
SMTP_PORT=587
SMTP_USER=kastriot@kastriottanaj.com
SMTP_PASSWORD=

# Display name on outgoing mail. Defaults to "Kastriot Tanaj".
# MAIL_FROM_NAME=Kastriot Tanaj

# Where contact-form enquiries arrive. This one can be anything you read.
LEAD_TO_EMAIL=kastriot.sym@gmail.com

# ── Newsletter ───────────────────────────────────────────────────────────────
# Absolute base for the links inside emails — confirm, unsubscribe, and "read it
# in your browser". Production is the default; override it only for local runs.
# PUBLIC_SITE_URL=https://kastriottanaj.com

# ── MailerLite (optional) ────────────────────────────────────────────────────
# Set the key and MailerLite becomes the list of record: every signup lands in
# the dashboard, MailerLite sends the double opt-in mail, and automations take
# it from there. Unset, the site keeps its own SQLite list and SMTP mails, and
# nothing here is called.
#
# The key is a credential — server-side only, never a PUBLIC_ var, and it lives
# in /etc/kastriottanaj/env at 640. Generate it in MailerLite under
# Integrations → MailerLite API → Generate new token; it is shown once.
# MAILERLITE_API_KEY=

# The group new subscribers join. This is what fires a "subscriber joins group"
# automation, so a welcome sequence needs it. Find the id in the URL of the
# group page: /subscribers/groups/<id>. Comma-separate for more than one.
# Unset, subscribers land in MailerLite ungrouped and no automation triggers.
# MAILERLITE_GROUP_ID=

# Who sends the "please confirm" mail. Default (unset, or "mailerlite"): the
# address is pushed as unconfirmed and MailerLite mails them — which REQUIRES
# Account settings → Subscribe settings → "Double opt-in for API and
# integrations" to be ON, or nobody ever receives a link. Set it to "site" to
# keep this site's own confirmation mail and /newsletter/confirmed/ page, and
# push to MailerLite only once an address has confirmed here.
# MAILERLITE_OPT_IN=mailerlite

# ── Meta Pixel (optional) ────────────────────────────────────────────────────
# The live pixel ID is a constant in src/components/MetaPixel.astro — it is a
# public identifier, so it lives in the repo like the GA tag. Set this only to
# point a build at a different pixel, or to an empty value to switch it off.
# It is baked into the HTML at build time, so it belongs in the BUILD
# environment (deploy.sh sources this file before `npm run build`).
# PUBLIC_META_PIXEL_ID=1234567890123456

# ── Meta Conversions API (optional) ──────────────────────────────────────────
# The server-side twin of the pixel: /api/lead posts a Lead straight to Meta,
# so the conversions ad blockers strip from the browser still arrive. Unset,
# nothing is sent and the browser pixel carries on alone.
#
# Generate the token in Events Manager → your dataset → Settings → Conversions
# API → Generate access token. It is a credential: server-side only, never a
# PUBLIC_ var, and it belongs in /etc/kastriottanaj/env at 640.
# META_CAPI_ACCESS_TOKEN=

# Set while testing to route events to Events Manager → Test events, where they
# show up live. Test events are NOT counted as conversions — unset it after.
# META_CAPI_TEST_EVENT_CODE=TEST12345

# Graph API version. Pinned in code to v26.0 (current as of August 2026);
# override here when Meta retires it — they expire roughly two years out.
# META_CAPI_VERSION=v26.0

# ── Spam (Cloudflare Turnstile — optional) ───────────────────────────────────
# Leave both unset and the form still works: honeypot + rate limit stay active.
# The site key must ALSO be set at build time (it is baked into the HTML).
# PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set by the systemd unit; listed here for local runs.
# HOST=127.0.0.1
# PORT=4321
# Leads and newsletter subscribers share this one file, so the nightly backup
# covers both.
# LEADS_DB_PATH=/var/www/kastriottanaj/data/leads.db
